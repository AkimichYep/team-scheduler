    <%- include('header') %>

    <style>
        .container {
            padding-top: 20px;
        }
    </style>

        h2 {
            color: #555;
            margin-top: 30px;
            margin-bottom: 15px;
            text-align: center;
            font-size: 18px;
            padding: 10px;
            background-color: #e3f2fd;
            border-left: 4px solid #2196F3;
        }

        .nav-controls {
            display: flex;
            gap: 10px;
            margin-bottom: 20px;
            justify-content: center;
            align-items: center;
            flex-wrap: wrap;
        }

        .nav-btn {
            padding: 8px 12px;
            background-color: #2196F3;
            color: white;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-weight: bold;
        }

        .nav-btn:hover {
            background-color: #0b7dda;
        }

        .current-date {
            font-size: 18px;
            font-weight: bold;
            color: #333;
            min-width: 200px;
            text-align: center;
        }

        .date-input {
            padding: 8px 12px;
            border: 1px solid #ddd;
            border-radius: 4px;
            font-size: 14px;
        }

        .hourly-table {
            width: 100%;
            border-collapse: collapse;
            background-color: white;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            margin-bottom: 30px;
        }

        .hourly-table th {
            padding: 12px 8px;
            text-align: center;
            border: 1px solid #999;
            font-weight: bold;
            background-color: #2196F3;
            color: white;
            font-size: 13px;
            min-width: 80px;
        }

        .hourly-table td {
            padding: 12px 8px;
            text-align: center;
            border: 1px solid #ddd;
            font-weight: bold;
            font-size: 12px;
            min-width: 80px;
        }

        .hour-header {
            background-color: #e3f2fd;
            font-weight: bold;
            color: #1976d2;
            writing-mode: horizontal-tb;
        }

        .date-header {
            text-align: left;
            background-color: #f5f5f5;
            border-right: 2px solid #999;
            min-width: 120px;
            font-weight: bold;
            color: #333;
        }

        .activity-cell.d {
            background-color: #c8e6c9;
            color: #333;
        }

        .activity-cell.s {
            background-color: #bbdefb;
            color: #333;
        }

        .activity-cell.oncall {
            background-color: #ffe0b2;
            color: #333;
        }

        .activity-cell.v {
            background-color: #f8bbd0;
            color: #333;
        }

        .activity-cell.h {
            background-color: #ef9a9a;
            color: #333;
        }

        .activity-cell.leave {
            background-color: #b0bec5;
            color: #333;
        }

        .activity-cell.leave {
            background-color: #b0bec5;
            color: #333;
        }

        .activity-cell.shifta { background-color: #a5d6a7; color: #1b5e20; }
        .activity-cell.shiftb { background-color: #80cbc4; color: #004d40; }
        .activity-cell.shiftc { background-color: #90caf9; color: #0d47a1; }
        .activity-cell.shiftd { background-color: #ce93d8; color: #4a148c; }
        .activity-cell.shifte { background-color: #ffcc80; color: #e65100; }

        .legend {
            background-color: white;
            border-radius: 8px;
            padding: 15px;
            margin-bottom: 20px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        }

        .legend-title {
            font-weight: bold;
            margin-bottom: 10px;
            color: #333;
        }

        .legend-items {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 10px;
        }

        .legend-item {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .legend-color {
            width: 20px;
            height: 20px;
            border-radius: 3px;
        }

        .summary-period {
            background-color: white;
            border-radius: 8px;
            padding: 20px;
            margin-bottom: 20px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        }

        .period-title {
            font-weight: bold;
            font-size: 16px;
            color: #2196F3;
            margin-bottom: 15px;
            padding-bottom: 10px;
            border-bottom: 2px solid #2196F3;
        }

        .buttons-container {
            text-align: center;
            margin-top: 20px;
            display: flex;
            gap: 10px;
            justify-content: center;
            flex-wrap: wrap;
        }

        .back-btn {
            padding: 10px 20px;
            background-color: #9e9e9e;
            color: white;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-weight: bold;
            text-decoration: none;
        }

        .back-btn:hover {
            background-color: #757575;
        }

        .date-cell-header {
            background-color: #f5f5f5;
            font-weight: bold;
            padding: 8px 4px;
            border: 1px solid #999;
        }

        .day-name {
            font-size: 11px;
            color: #666;
        }

        .loading {
            text-align: center;
            padding: 40px;
            font-size: 18px;
            color: #666;
        }
    </style>
    <div class="container">
        <h1>Weekly Hourly Summary - 24-Hour View</h1>

        <div class="legend">
            <div class="legend-title">Activity Types (Hour Slots: 00-01, 01-02, ... 23-24):</div>
            <div class="legend-items">
                <div class="legend-item">
                    <div class="legend-color" style="background-color: #c8e6c9;"></div>
                    <span>D - Development</span>
                </div>
                <div class="legend-item">
                    <div class="legend-color" style="background-color: #bbdefb;"></div>
                    <span>S - Support</span>
                </div>
                <div class="legend-item">
                    <div class="legend-color" style="background-color: #ffe0b2;"></div>
                    <span>OnCall</span>
                </div>
                <div class="legend-item">
                    <div class="legend-color" style="background-color: #f8bbd0;"></div>
                    <span>V - Vacation</span>
                </div>
                <div class="legend-item">
                    <div class="legend-color" style="background-color: #ef9a9a;"></div>
                    <span>H - Holiday</span>
                </div>
                <div class="legend-item">
                    <div class="legend-color" style="background-color: #b0bec5;"></div>
                    <span>Leave</span>
                </div>
                <div class="legend-item">
                    <div class="legend-color" style="background-color: #a5d6a7;"></div>
                    <span>A - Shift A (02-11)</span>
                </div>
                <div class="legend-item">
                    <div class="legend-color" style="background-color: #80cbc4;"></div>
                    <span>B - Shift B (03-12)</span>
                </div>
                <div class="legend-item">
                    <div class="legend-color" style="background-color: #90caf9;"></div>
                    <span>C - Shift C (07-16)</span>
                </div>
                <div class="legend-item">
                    <div class="legend-color" style="background-color: #ce93d8;"></div>
                    <span>D - Shift D (10-19)</span>
                </div>
                <div class="legend-item">
                    <div class="legend-color" style="background-color: #ffcc80;"></div>
                    <span>E - Shift E (09-18)</span>
                </div>
                <div class="legend-item">
                    <div class="legend-color" style="background-color: #d0d0d0;"></div>
                    <span>Off</span>
                </div>
            </div>
        </div>

        <div class="nav-controls">
            <button class="nav-btn" onclick="previousDay()">← Previous Week</button>
            <input type="date" id="dateInput" class="date-input" onchange="loadWeeksSummary()">
            <button class="nav-btn" onclick="nextDay()">Next Week →</button>
        </div>

        <div id="loadingContainer" class="loading" style="display: none;">Loading summary...</div>
        <div id="summaryContainer"></div>

        <div class="buttons-container">
            <button class="back-btn" onclick="location.href='/scheduler'">Back to Scheduler</button>
        </div>
    </div>

    <script>
        const CURRENT_USER_ID = '<%= userId %>';
        let currentDate = new Date(2026, 5, 9); // June 9, 2026
        let scheduleData = {};

        const SHIFT_PATTERNS = {
            'ShiftA': ['Off','Off','S','S','S','S','S','D','D','D','D','Off','Off','Off','Off','Off','Off','Off','Off','Off','Off','Off','Off','Off'],
            'ShiftB': ['Off','Off','Off','S','S','S','S','S','D','D','D','D','Off','Off','Off','Off','Off','Off','Off','Off','Off','Off','Off','Off'],
            'ShiftC': ['Off','Off','Off','Off','Off','Off','Off','S','S','S','S','S','D','D','D','D','Off','Off','Off','Off','Off','Off','Off','Off'],
            'ShiftD': ['Off','Off','Off','Off','Off','Off','Off','Off','Off','Off','S','S','S','S','D','D','D','D','S','Off','Off','Off','Off','Off'],
            'ShiftE': ['Off','Off','Off','Off','Off','Off','Off','Off','Off','D','D','D','D','S','S','S','S','S','Off','Off','Off','Off','Off','Off']
        };

        function resolveHourlyActivity(activity, hour) {
            let normalizedActivity = activity;
            if (activity === 'Development') normalizedActivity = 'D';
            if (activity === 'Support') normalizedActivity = 'S';
            if (activity === 'OnCall') normalizedActivity = 'OC';

            if (SHIFT_PATTERNS[normalizedActivity]) {
                return SHIFT_PATTERNS[normalizedActivity][hour] || 'Off';
            }
            return normalizedActivity || 'Off';
        }

        function getActivityDisplay(activity) {
            const map = { 'D': 'D', 'S': 'S', 'OnCall': 'OC', 'Leave': 'L', 'ShiftA': 'A', 'ShiftB': 'B', 'ShiftC': 'C', 'ShiftD': 'D', 'ShiftE': 'E', 'ShiftA_M': 'A', 'ShiftB_M': 'B', 'ShiftC_M': 'C', 'ShiftD_M': 'D', 'ShiftE_M': 'E', 'ShiftA_S': 'A', 'ShiftB_S': 'B', 'ShiftC_S': 'C', 'ShiftD_S': 'D', 'ShiftE_S': 'E', 'ShiftA_D': 'A', 'ShiftB_D': 'B', 'ShiftC_D': 'C', 'ShiftD_D': 'D', 'ShiftE_D': 'E', 'Off': 'Off', 'V': 'V', 'Vacation': 'V', 'H': 'H', 'Holiday': 'H', 'ShiftA_M_OC': 'A >', 'ShiftB_M_OC': 'B >', 'ShiftC_M_OC': 'C >', 'ShiftD_M_OC': 'D >', 'ShiftE_M_OC': 'E >', 'ShiftA_S_OC': 'A >', 'ShiftB_S_OC': 'B >', 'ShiftC_S_OC': 'C >', 'ShiftD_S_OC': 'D >', 'ShiftE_S_OC': 'E >', 'ShiftA_D_OC': 'A >', 'ShiftB_D_OC': 'B >', 'ShiftC_D_OC': 'C >', 'ShiftD_D_OC': 'D >', 'ShiftE_D_OC': 'E >', 'OC_ShiftA_M': '< A', 'OC_ShiftB_M': '< B', 'OC_ShiftC_M': '< C', 'OC_ShiftD_M': '< D', 'OC_ShiftE_M': '< E', 'OC_ShiftA_S': '< A', 'OC_ShiftB_S': '< B', 'OC_ShiftC_S': '< C', 'OC_ShiftD_S': '< D', 'OC_ShiftE_S': '< E', 'OC_ShiftA_D': '< A', 'OC_ShiftB_D': '< B', 'OC_ShiftC_D': '< C', 'OC_ShiftD_D': '< D', 'OC_ShiftE_D': '< E', 'OC_ShiftA_M_OC': '< A >', 'OC_ShiftB_M_OC': '< B >', 'OC_ShiftC_M_OC': '< C >', 'OC_ShiftD_M_OC': '< D >', 'OC_ShiftE_M_OC': '< E >', 'OC_ShiftA_S_OC': '< A >', 'OC_ShiftB_S_OC': '< B >', 'OC_ShiftC_S_OC': '< C >', 'OC_ShiftD_S_OC': '< D >', 'OC_ShiftE_S_OC': '< E >', 'OC_ShiftA_D_OC': '< A >', 'OC_ShiftB_D_OC': '< B >', 'OC_ShiftC_D_OC': '< C >', 'OC_ShiftD_D_OC': '< D >', 'OC_ShiftE_D_OC': '< E >' };
            if (map[activity] !== undefined) return map[activity];
            if (!activity) return '-';
            // OC combo display: < A, A >, < A >
            const ocPre  = /^OC_(Shift[A-E](_[MSD])?)$/.exec(activity);
            const ocSuf  = /^(Shift[A-E](_[MSD])?)_OC$/.exec(activity);
            const ocBoth = /^OC_(Shift[A-E](_[MSD])?)_OC$/.exec(activity);
            if (ocPre)  return '< ' + getActivityDisplay(ocPre[1]);
            if (ocSuf)  return getActivityDisplay(ocSuf[1]) + ' >';
            if (ocBoth) return '< ' + getActivityDisplay(ocBoth[1]) + ' >';
            return activity;
        }

        document.addEventListener('DOMContentLoaded', function() {
            const today = new Date('2026-06-09');
            currentDate = new Date(today);
            document.getElementById('dateInput').valueAsDate = today;
            loadWeeksSummary();
        });

        function getWeekStart(date) {
            const d = new Date(date);
            const day = d.getDay();
            const diff = d.getDate() - day + 1; // Monday start
            return new Date(d.setDate(diff));
        }

        function loadWeeksSummary() {
            const dateInput = document.getElementById('dateInput');
            const dateStr = dateInput.value;
            if (!dateStr) return;

            const baseDate = new Date(dateStr + 'T00:00:00');
            const weekStart = getWeekStart(baseDate);
            const weekBefore = new Date(weekStart);
            weekBefore.setDate(weekBefore.getDate() - 7);
            const weekAfter = new Date(weekStart);
            weekAfter.setDate(weekAfter.getDate() + 7);

            // Update display
            const weekEnd = new Date(weekStart);
            weekEnd.setDate(weekEnd.getDate() + 6);
            const dateFormat = new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric' });
            document.getElementById('dateInput').valueAsDate = baseDate;

            // Load all three weeks
            document.getElementById('loadingContainer').style.display = 'block';
            document.getElementById('summaryContainer').innerHTML = '';

            const promises = [];
            promises.push(loadWeekData(weekBefore, 'weekBefore'));
            promises.push(loadWeekData(weekStart, 'currentWeek'));
            promises.push(loadWeekData(weekAfter, 'weekAfter'));

            Promise.all(promises)
                .then(() => {
                    document.getElementById('loadingContainer').style.display = 'none';
                    renderWeeksSummary();
                })
                .catch(err => {
                    console.error('Error loading summary:', err);
                    document.getElementById('loadingContainer').style.display = 'none';
                    document.getElementById('summaryContainer').innerHTML = '<div class="loading">Error loading summary</div>';
                });
        }

        function loadWeekData(weekStart, label) {
            const promises = [];
            for (let i = 0; i < 7; i++) {
                const date = new Date(weekStart);
                date.setDate(date.getDate() + i);
                const dateStr = formatDate(date);

                promises.push(
                    fetch(`/api/proxy/schedule/day/${CURRENT_USER_ID}/hours?date=${dateStr}`)
                        .then(res => res.json())
                        .then(data => {
                            if (!scheduleData[label]) scheduleData[label] = {};
                            scheduleData[label][dateStr] = data;
                        })
                        .catch(err => console.error('Error loading hourly data for ' + dateStr, err))
                );
            }
            return Promise.all(promises);
        }

        function renderWeeksSummary() {
            let html = '';

            // Week Before
            if (scheduleData.weekBefore) {
                html += '<div class="summary-period">';
                html += '<div class="period-title">📅 Week Before</div>';
                html += renderWeekTable(scheduleData.weekBefore);
                html += '</div>';
            }

            // Current Week
            if (scheduleData.currentWeek) {
                html += '<div class="summary-period">';
                html += '<div class="period-title">📌 Current Week</div>';
                html += renderWeekTable(scheduleData.currentWeek);
                html += '</div>';
            }

            // Week After
            if (scheduleData.weekAfter) {
                html += '<div class="summary-period">';
                html += '<div class="period-title">📆 Week After</div>';
                html += renderWeekTable(scheduleData.weekAfter);
                html += '</div>';
            }

            document.getElementById('summaryContainer').innerHTML = html;
        }

        function renderWeekTable(weekData) {
            const sortedDates = Object.keys(weekData).sort();
            let html = '<table class="hourly-table">';

            // Header row with day labels
            html += '<tr>';
            html += '<th class="date-header">Date (Day)</th>';
            sortedDates.forEach(date => {
                const dateObj = new Date(date + 'T00:00:00');
                const dayName = dateObj.toLocaleDateString('en-US', { weekday: 'short' });
                html += `<th colspan="1" class="hour-header" style="text-align: center; padding: 8px;">${dayName}<br/>${date}</th>`;
            });
            html += '</tr>';

            // Hours row with time slots
            html += '<tr>';
            html += '<th class="date-header">Hour</th>';
            sortedDates.forEach(() => {
                // Placeholder for hour columns
            });
            html += '</tr>';

            // Data rows - one per hour
            for (let hour = 0; hour < 24; hour++) {
                html += '<tr>';
                const startHour = String(hour).padStart(2, '0');
                const endHour = String(hour + 1).padStart(2, '0');
                html += `<td class="date-cell-header">${startHour}-${endHour}</td>`;

                sortedDates.forEach(date => {
                    const dayEntries = weekData[date] || [];
                    const entry = dayEntries.find(e => e.hourOfDay === hour);
                    const rawActivity = entry ? entry.activity : null;
                    const activity = resolveHourlyActivity(rawActivity, hour);
                    const activityClass = activity.toLowerCase();
                    html += `<td class="activity-cell ${activityClass}">${activity}</td>`;
                });

                html += '</tr>';
            }

            html += '</table>';
            return html;
        }

        function previousDay() {
            const dateInput = document.getElementById('dateInput');
            const date = new Date(dateInput.valueAsDate);
            date.setDate(date.getDate() - 1);
            dateInput.valueAsDate = date;
            loadWeeksSummary();
        }

        function nextDay() {
            const dateInput = document.getElementById('dateInput');
            const date = new Date(dateInput.valueAsDate);
            date.setDate(date.getDate() + 1);
            dateInput.valueAsDate = date;
            loadWeeksSummary();
        }

        function formatDate(date) {
            const year = date.getFullYear();
            const month = String(date.getMonth() + 1).padStart(2, '0');
            const day = String(date.getDate()).padStart(2, '0');
            return `${year}-${month}-${day}`;
        }
    </script>


