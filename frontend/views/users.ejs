<h1>User Management</h1>
<a href="/add"><button type="button">Add New User</button></a>
<a href="/logout"><button type="button">Logout</button></a>

<table border="1">
    <tr>
        <th>Username</th>
        <th>Role</th>
        <th>Project</th>
        <th>Actions</th>
    </tr>
    <% users.forEach(user => { %>
        <tr>
            <td><%= user.username %></td>
            <td><%= user.role %></td>
            <td><%= user.project %></td>
            <td>
                <a href="/edit/<%= user.id %>"><button type="button">Edit</button></a>
                <button type="button" onclick="deleteUser('<%= user.id %>')">Delete</button>
            </td>
        </tr>
    <% }) %>
</table>

<script>
    function deleteUser(id) {
        if(confirm('Are you sure you want to delete this user?')) {
            // Note: credentials: 'include' is needed to send session cookies
            fetch(`/proxy/delete/${id}`, { method: 'DELETE', credentials: 'include' })
            .then(response => {
                if (response.ok) {
                    location.reload();
                } else {
                    alert("Failed to delete user.");
                }
            })
            .catch(error => console.error("Error:", error));
        }
    }
</script>