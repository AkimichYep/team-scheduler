<html>
<head>
    <title>User Management</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 20px; }
        h1 { color: #333; }
        .action-buttons { margin-bottom: 20px; }
        .action-buttons a, .action-buttons button { padding: 10px 15px; margin-right: 10px; text-decoration: none; }
        .add-btn { background-color: #4CAF50; color: white; padding: 10px 15px; cursor: pointer; border: none; }
        .add-btn:hover { background-color: #45a049; }
        .roles-btn { background-color: #2196F3; color: white; padding: 10px 15px; cursor: pointer; border: none; }
        .roles-btn:hover { background-color: #0b7dda; }
        .logout-btn { background-color: #999; color: white; padding: 10px 15px; cursor: pointer; border: none; }
        .logout-btn:hover { background-color: #888; }
        table { width: 100%; border-collapse: collapse; margin-top: 20px; }
        table, th, td { border: 1px solid #ddd; }
        th { background-color: #4CAF50; color: white; text-align: left; padding: 12px; }
        td { padding: 12px; }
        tr:hover { background-color: #f5f5f5; }
        .edit-btn, .delete-btn { padding: 5px 10px; cursor: pointer; border: none; margin-right: 5px; }
        .edit-btn { background-color: #2196F3; color: white; }
        .delete-btn { background-color: #f44336; color: white; }
    </style>
</head>
<body>
    <h1>User Management</h1>

    <div class="action-buttons">
        <button class="add-btn" onclick="location.href='/add'">Add New User</button>
        <button class="roles-btn" onclick="location.href='/roles'">Manage Roles</button>
        <button class="logout-btn" onclick="location.href='/logout'">Logout</button>
    </div>

    <table>
        <tr>
            <th>Username</th>
            <th>Role</th>
            <th>Project</th>
            <th>Active</th>
            <th>Actions</th>
        </tr>
        <% users.forEach(user => { %>
            <tr>
                <td><%= user.username %></td>
                <td><%= user.role.name %></td>
                <td><%= user.project %></td>
                <td><%= user.active ? 'Yes' : 'No' %></td>
                <td>
                    <button class="edit-btn" onclick="location.href='/edit/<%= user.id %>'">Edit</button>
                    <button class="delete-btn" onclick="deleteUser('<%= user.id %>')">Delete</button>
                </td>
            </tr>
        <% }) %>
    </table>

    <script>
        function deleteUser(id) {
            if(confirm('Are you sure you want to delete this user?')) {
                fetch(`/proxy/delete/${id}`, { method: 'DELETE', credentials: 'include' })
                .then(response => {
                    if (response.ok) {
                        location.reload();
                    } else {
                        alert("Failed to delete user.");
                    }
                })
                .catch(error => console.error("Error:", error));
            }
        }
    </script>
</body>
</html>
