<html>
<head>
    <title>Team Summary by Day - Team Scheduler</title>
</head>
<body>
    <%- include('header', { activePage: 'summary' }) %>

    <div class="container summary-page">
        <header class="page-header">
            <h1>Team Schedule by Day <span class="subtitle">- Hourly Breakdown</span></h1>
        </header>

        <div class="card legend-card">
            <h3>Activity Legend</h3>
            <div class="legend-grid">
                <div class="legend-item"><span class="color-box d"></span> D - Development</div>
                <div class="legend-item"><span class="color-box s"></span> S - Support</div>
                <div class="legend-item"><span class="color-box oncall"></span> OnCall</div>
                <div class="legend-item"><span class="color-box v"></span> V - Vacation</div>
                <div class="legend-item"><span class="color-box h"></span> H - Holiday</div>
                <div class="legend-item"><span class="color-box leave"></span> Leave</div>
                <div class="legend-item"><span class="color-box shifta"></span> Shift A (02-11)</div>
                <div class="legend-item"><span class="color-box shiftb"></span> Shift B (03-12)</div>
                <div class="legend-item"><span class="color-box shiftc"></span> Shift C (07-16)</div>
                <div class="legend-item"><span class="color-box shiftd"></span> Shift D (10-19)</div>
                <div class="legend-item"><span class="color-box shifte"></span> Shift E (09-18)</div>
                <div class="legend-item"><span class="color-box off"></span> Off</div>
            </div>
        </div>

        <div class="card controls-card">
            <div class="controls-row">
                <div class="control-group view-toggle">
                    <a href="/summary" class="btn btn-secondary">📊 Back to Weekly View</a>
                    <a href="/summary-by-day" class="btn btn-primary active-view">📅 Team by Day (Hourly)</a>
                </div>
                <div class="control-group date-nav">
                    <button class="btn btn-primary" onclick="previousWeek()">← Prev Week</button>
                    <input type="date" id="dateInput" class="form-input" onchange="loadSummaryByDay()">
                    <button class="btn btn-primary" onclick="nextWeek()">Next Week →</button>
                </div>
            </div>

            <div class="member-selection-area">
                <h4>Select Team Members</h4>
                <div class="users-grid" id="usersSelection"></div>
                <div class="selection-actions">
                    <button class="btn btn-secondary btn-sm" onclick="selectAllUsers()">Select All</button>
                    <button class="btn btn-danger btn-sm" onclick="clearAllUsers()">Clear All</button>
                    <button class="btn btn-accent" onclick="loadSummaryByDay()">Load Summary</button>
                </div>
            </div>
        </div>

        <div id="errorContainer"></div>
        <div id="loadingContainer" class="loading-overlay" style="display: none;">
            <div class="spinner"></div>
            <p>Loading summary data...</p>
        </div>

        <div class="table-container shadow-sm">
            <table class="summary-table" id="summaryTable"></table>
        </div>
    </div>

    <style>
        .summary-page { max-width: 100%; }
        .page-header h1 { color: var(--primary-color); margin-bottom: 25px; }
        .subtitle { font-weight: normal; font-size: 0.7em; color: #666; }
        
        .legend-card h3 { margin-top: 0; font-size: 1.1em; }
        .legend-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 10px; font-size: 0.85em; }
        .legend-item { display: flex; align-items: center; gap: 8px; }
        .color-box { width: 16px; height: 16px; border-radius: 3px; border: 1px solid rgba(0,0,0,0.1); }
        .color-box.d { background-color: #c8e6c9; }
        .color-box.s { background-color: #bbdefb; }
        .color-box.oncall { background-color: #ffe0b2; }
        .color-box.v { background-color: #f8bbd0; }
        .color-box.h { background-color: #ef9a9a; }
        .color-box.leave { background-color: #b0bec5; }
        .color-box.shifta { background-color: #a5d6a7; }
        .color-box.shiftb { background-color: #80cbc4; }
        .color-box.shiftc { background-color: #90caf9; }
        .color-box.shiftd { background-color: #ce93d8; }
        .color-box.shifte { background-color: #ffcc80; }
        .color-box.off { background-color: #d0d0d0; }

        .controls-card { margin-top: 20px; }
        .controls-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; flex-wrap: wrap; gap: 15px; }
        .view-toggle { display: flex; gap: 10px; }
        .date-nav { display: flex; align-items: center; gap: 15px; }
        .form-input { padding: 8px; border: 1px solid var(--border-color); border-radius: 4px; }
        
        .member-selection-area h4 { margin: 0 0 15px 0; border-top: 1px solid #eee; padding-top: 15px; }
        .users-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 10px; margin-bottom: 20px; }
        .user-checkbox-item { display: flex; align-items: center; gap: 8px; padding: 8px; background: #f9f9f9; border-radius: 4px; cursor: pointer; transition: background 0.2s; }
        .user-checkbox-item:hover { background: #eee; }
        .user-checkbox-item input { width: 16px; height: 16px; margin: 0; }
        .selection-actions { display: flex; gap: 10px; justify-content: center; }
        .btn-sm { padding: 6px 12px; font-size: 0.85em; }

        .table-container { overflow-x: auto; background: white; border-radius: 8px; margin-top: 30px; }
        .summary-table { width: 100%; border-collapse: collapse; font-size: 0.8em; }
        .day-header { background-color: var(--primary-color); color: white; padding: 12px; font-size: 1.1em; text-align: left; }
        .hour-header { background-color: #f0f7ff; color: #555; padding: 6px 4px; border: 1px solid #e0e0e0; min-width: 40px; }
        .member-col { background-color: #f9f9f9; font-weight: bold; text-align: left; padding-left: 15px; border: 1px solid #e0e0e0; min-width: 120px; position: sticky; left: 0; z-index: 10; }
        .activity-cell { height: 30px; border: 1px solid #eee; text-align: center; font-weight: bold; }
        
        .activity-cell.d { background-color: #e8f5e9; color: #2e7d32; }
        .activity-cell.s { background-color: #e3f2fd; color: #1565c0; }
        .activity-cell.oncall { background-color: #fff3e0; color: #e65100; }
        .activity-cell.v { background-color: #fce4ec; color: #c2185b; }
        .activity-cell.h { background-color: #ffebee; color: #c62828; }
        .activity-cell.leave { background-color: #eceff1; color: #455a64; }
        .activity-cell.shifta { background-color: #a5d6a7; }
        .activity-cell.shiftb { background-color: #80cbc4; }
        .activity-cell.shiftc { background-color: #90caf9; }
        .activity-cell.shiftd { background-color: #ce93d8; }
        .activity-cell.shifte { background-color: #ffcc80; }
        .activity-cell.off { background-color: #f5f5f5; color: #999; }

        .loading-overlay { text-align: center; padding: 40px; }
        .spinner { width: 40px; height: 40px; border: 4px solid #f3f3f3; border-top: 4px solid var(--primary-color); border-radius: 50%; margin: 0 auto 15px; animation: spin 1s linear infinite; }
        @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
        .view-toggle .btn.active-view {
            background-color: var(--primary-dark);
            cursor: default;
            pointer-events: none;
        }
    </style>

    <script>
        let currentDate = new Date(2026, 5, 9); // June 9, 2026
        let selectedUserIds = [];
        let allUsers = [];
        let scheduleData = {};
        let scheduleCache = {}; // Cache: key = "userId:date" -> data

        // Cache utility functions
        function getCachedDayHours(userId, date) {
            const key = `${userId}:${date}`;
            return scheduleCache[key] || null;
        }

        function setCachedDayHours(userId, date, data) {
            const key = `${userId}:${date}`;
            scheduleCache[key] = data;
        }

        function clearCache() {
            scheduleCache = {};
        }

        // Expand grouped entries (with hourRange) into individual hour entries
        function expandGroupedEntries(groupedEntries) {
            const expanded = [];
            groupedEntries.forEach(entry => {
                // Parse hourRange: "0" or "0-3" or "10-23"
                const [startStr, endStr] = entry.hourRange.split('-');
                const startHour = parseInt(startStr);
                const endHour = endStr ? parseInt(endStr) : startHour;

                for (let hour = startHour; hour <= endHour; hour++) {
                    expanded.push({
                        date: entry.date,
                        hourOfDay: hour,
                        activity: entry.activity,
                        isOnCall: entry.isOnCall,
                        onCallMorning: entry.onCallMorning,
                        onCallNight: entry.onCallNight,
                        notes: entry.notes
                    });
                }
            });
            return expanded;
        }

        // Shift patterns: index = hour (0-23), value = actual activity
        const SHIFT_PATTERNS = {
            'ShiftA': ['Off','Off','S','S','S','S','S','D','D','D','D','Off','Off','Off','Off','Off','Off','Off','Off','Off','Off','Off','Off','Off'],
            'ShiftB': ['Off','Off','Off','S','S','S','S','S','D','D','D','D','Off','Off','Off','Off','Off','Off','Off','Off','Off','Off','Off','Off'],
            'ShiftC': ['Off','Off','Off','Off','Off','Off','Off','S','S','S','S','S','D','D','D','D','Off','Off','Off','Off','Off','Off','Off','Off'],
            'ShiftD': ['Off','Off','Off','Off','Off','Off','Off','Off','Off','Off','S','S','S','S','D','D','D','D','S','Off','Off','Off','Off','Off'],
            'ShiftE': ['Off','Off','Off','Off','Off','Off','Off','Off','Off','D','D','D','D','S','S','S','S','S','Off','Off','Off','Off','Off','Off']
        };

        // Resolve actual D/S/Off for a given activity + hour
        function resolveHourlyActivity(activity, hour) {
            if (SHIFT_PATTERNS[activity]) {
                return SHIFT_PATTERNS[activity][hour] || 'Off';
            }
            return activity || 'Off';
        }

        document.addEventListener('DOMContentLoaded', function() {
            const today = new Date('2026-06-09');
            currentDate = new Date(today);
            document.getElementById('dateInput').valueAsDate = today;
            loadAllUsers();
        });

        function loadAllUsers() {
            fetch('/api/proxy/schedule/all-users')
                .then(res => res.json())
                .then(users => {
                    allUsers = users;
                    renderUserCheckboxes();
                    
                    // Try to load saved selection from localStorage
                    const savedIds = localStorage.getItem('selected_team_members');
                    let idsToSelect = [];
                    
                    if (savedIds) {
                        try {
                            const parsedIds = JSON.parse(savedIds);
                            // Only select users that still exist in the allUsers list
                            idsToSelect = parsedIds.filter(id => users.some(u => u.id === id));
                        } catch (e) {
                            console.error('Error parsing saved users:', e);
                        }
                    }
                    
                    // If no saved selection or all saved users no longer exist, select first 3 as default
                    if (idsToSelect.length === 0) {
                        const defaultCount = Math.min(3, users.length);
                        for (let i = 0; i < defaultCount; i++) {
                            idsToSelect.push(users[i].id);
                        }
                    }
                    
                    idsToSelect.forEach(id => toggleUser(id, true));
                    loadSummaryByDay();
                })
                .catch(err => {
                    console.error('Error loading users:', err);
                    showError('Failed to load team members');
                });
        }

        function renderUserCheckboxes() {
            const container = document.getElementById('usersSelection');
            container.innerHTML = '';

            allUsers.forEach(user => {
                const div = document.createElement('div');
                div.className = 'user-checkbox-item';
                div.innerHTML = `
                    <input type="checkbox" id="user-${user.id}" onchange="toggleUser(${user.id}, this.checked)">
                    <label for="user-${user.id}">${user.username}</label>
                `;
                container.appendChild(div);
            });
        }

        function toggleUser(userId, checked) {
            if (checked) {
                if (!selectedUserIds.includes(userId)) {
                    selectedUserIds.push(userId);
                }
                const checkbox = document.getElementById(`user-${userId}`);
                if (checkbox) checkbox.checked = true;
            } else {
                selectedUserIds = selectedUserIds.filter(id => id !== userId);
                const checkbox = document.getElementById(`user-${userId}`);
                if (checkbox) checkbox.checked = false;
            }
            clearCache(); // Clear cache when user selection changes
            saveSelection();
        }

        function saveSelection() {
            localStorage.setItem('selected_team_members', JSON.stringify(selectedUserIds));
        }

        function selectAllUsers() {
            allUsers.forEach(user => toggleUser(user.id, true));
        }

        function clearAllUsers() {
            allUsers.forEach(user => toggleUser(user.id, false));
            selectedUserIds = [];
        }

        function getWeekStart(date) {
            const d = new Date(date);
            const day = d.getDay();
            const diff = d.getDate() - day + 1; // Monday start
            return new Date(d.setDate(diff));
        }

        function loadSummaryByDay() {
            if (selectedUserIds.length === 0) {
                const msg = 'Please select at least one team member';
                showError(msg);
                console.warn(msg);
                document.getElementById('summaryTable').innerHTML = '';
                return;
            }

            const dateInput = document.getElementById('dateInput');
            const selectedDateStr = dateInput.value;
            if (!selectedDateStr) {
                showError('Please select a date');
                return;
            }

            const baseDate = new Date(selectedDateStr + 'T00:00:00');
            const weekStart = getWeekStart(baseDate);

            document.getElementById('loadingContainer').style.display = 'block';
            document.getElementById('summaryTable').innerHTML = '';
            document.getElementById('errorContainer').innerHTML = '';

            console.log('Loading summary for week starting:', formatDate(weekStart), 'Selected users:', selectedUserIds);

            // Check if all data is cached
            let allCached = true;
            for (let i = 0; i < 7; i++) {
                const date = new Date(weekStart);
                date.setDate(date.getDate() + i);
                const dateStr = formatDate(date);

                for (const userId of selectedUserIds) {
                    const cached = getCachedDayHours(userId, dateStr);
                    if (!cached) {
                        allCached = false;
                        break;
                    }
                }
                if (!allCached) break;
            }

            // If all cached, use cached data
            if (allCached) {
                console.log('✓ All data found in cache, loading cached data...');
                for (let i = 0; i < 7; i++) {
                    const date = new Date(weekStart);
                    date.setDate(date.getDate() + i);
                    const dateStr = formatDate(date);

                    selectedUserIds.forEach(userId => {
                        if (!scheduleData[userId]) scheduleData[userId] = {};
                        scheduleData[userId][dateStr] = getCachedDayHours(userId, dateStr);
                    });
                }
                document.getElementById('loadingContainer').style.display = 'none';
                renderSummaryByDay(weekStart);
                return;
            }

            // Fetch all week data for selected users in ONE optimized request
            const weekStartStr = formatDate(weekStart);
            const params = new URLSearchParams();
            selectedUserIds.forEach(id => params.append('userIds', id));

            fetch(`/api/proxy/schedule/team/week/${weekStartStr}?${params}`)
                .then(res => {
                    if (!res.ok) {
                        throw new Error(`HTTP error! status: ${res.status}`);
                    }
                    return res.json();
                })
                .then(teamData => {
                    // Process and cache the data
                    for (const userId in teamData) {
                        const userIdNum = parseInt(userId);
                        if (!scheduleData[userIdNum]) scheduleData[userIdNum] = {};

                        let entries = teamData[userId];

                        // Expand grouped entries (with hourRange) to individual hours
                        entries = expandGroupedEntries(entries);

                        const entriesByDate = {};

                        // Group entries by date
                        entries.forEach(entry => {
                            if (!entriesByDate[entry.date]) {
                                entriesByDate[entry.date] = [];
                            }
                            entriesByDate[entry.date].push(entry);
                        });

                        // Store in cache and scheduleData
                        for (const dateStr in entriesByDate) {
                            const dayEntries = entriesByDate[dateStr];
                            scheduleData[userIdNum][dateStr] = dayEntries;
                            setCachedDayHours(userIdNum, dateStr, dayEntries);
                            console.log(`✓ Loaded ${dayEntries.length} entries for user ${userIdNum} on ${dateStr}`);
                        }
                    }

                    document.getElementById('loadingContainer').style.display = 'none';
                    renderSummaryByDay(weekStart);
                })
                .catch(err => {
                    console.error('✗ Error loading team week schedule:', err);
                    document.getElementById('loadingContainer').style.display = 'none';
                    showError('Failed to load team summary: ' + err.message);
                });
        }

        function renderSummaryByDay(weekStart) {
            const table = document.getElementById('summaryTable');
            let html = '';

            // Render each day of the week
            for (let dayIndex = 0; dayIndex < 7; dayIndex++) {
                const date = new Date(weekStart);
                date.setDate(date.getDate() + dayIndex);
                const dateStr = formatDate(date);
                const dayName = date.toLocaleDateString('en-US', { weekday: 'long' });

                // Day header row with day name and date
                html += '<tr>';
                html += `<th colspan="25" class="day-header">📅 ${dayName} - ${dateStr}</th>`;
                html += '</tr>';

                // Hour header row
                html += '<tr>';
                html += '<th class="hour-header" style="background-color: #f5f5f5; font-weight: bold; font-size: 11px;">User</th>';
                for (let hour = 0; hour < 24; hour++) {
                    const startHour = String(hour).padStart(2, '0');
                    const endHour = String(hour + 1).padStart(2, '0');
                    html += `<th class="hour-header">${startHour}-${endHour}</th>`;
                }
                html += '</tr>';

                // User rows for this day
                selectedUserIds.forEach(userId => {
                    const user = allUsers.find(u => u.id === userId);
                    const userName = user ? user.username : 'Unknown';
                    const dayEntries = scheduleData[userId] ? (scheduleData[userId][dateStr] || []) : [];

                    // Validate dayEntries is an array
                    if (!Array.isArray(dayEntries)) {
                        console.warn('dayEntries is not an array for user', userId, dayEntries);
                        return;
                    }

                    html += '<tr class="user-row">';
                    html += `<td class="member-col">${userName}</td>`;

                    for (let hour = 0; hour < 24; hour++) {
                        const entry = dayEntries.find(e => {
                            const hourValue = e.hourOfDay !== undefined ? e.hourOfDay : e.hour;
                            return hourValue === hour;
                        });
                        const rawActivity = entry ? entry.activity : 'Off';
                        const activity = resolveHourlyActivity(rawActivity, hour);
                        const activityClass = activity.toLowerCase();

                        html += `<td class="activity-cell ${activityClass}">${activity}</td>`;
                    }

                    html += '</tr>';
                });

                // Add a spacing row between days
                if (dayIndex < 6) {
                    html += '<tr class="spacing-row"><td colspan="25"></td></tr>';
                }
            }

            console.log('Rendering table with HTML length:', html.length);
            table.innerHTML = html;
            console.log('Table rendered successfully');
        }

        function previousWeek() {
            const dateInput = document.getElementById('dateInput');
            const date = new Date(dateInput.value + 'T00:00:00');
            date.setDate(date.getDate() - 7);
            dateInput.valueAsDate = date;
            loadSummaryByDay();
        }

        function nextWeek() {
            const dateInput = document.getElementById('dateInput');
            const date = new Date(dateInput.value + 'T00:00:00');
            date.setDate(date.getDate() + 7);
            dateInput.valueAsDate = date;
            loadSummaryByDay();
        }

        function formatDate(date) {
            const year = date.getFullYear();
            const month = String(date.getMonth() + 1).padStart(2, '0');
            const day = String(date.getDate()).padStart(2, '0');
            return `${year}-${month}-${day}`;
        }

        function showError(message) {
            const errorContainer = document.getElementById('errorContainer');
            errorContainer.innerHTML = `<div class="error-message">⚠️ ${message}</div>`;
            console.error('Error:', message);
        }
    </script>
</body>
</html>

