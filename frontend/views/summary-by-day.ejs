<html>
<head>
    <title>Team Summary by Day - Hourly</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            background-color: #f5f5f5;
        }

        .container {
            max-width: 100%;
            margin: 0 auto;
            padding: 20px;
            overflow-x: auto;
        }

        h1 {
            color: #333;
            margin-bottom: 20px;
            text-align: center;
        }

        .controls-panel {
            background-color: white;
            border-radius: 8px;
            padding: 20px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            margin-bottom: 20px;
        }

        .controls-title {
            font-weight: bold;
            margin-bottom: 15px;
            color: #333;
            font-size: 16px;
        }

        .nav-controls {
            display: flex;
            gap: 10px;
            margin-bottom: 20px;
            justify-content: center;
            align-items: center;
            flex-wrap: wrap;
        }

        .nav-btn {
            padding: 8px 12px;
            background-color: #2196F3;
            color: white;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-weight: bold;
        }

        .nav-btn:hover {
            background-color: #0b7dda;
        }

        .current-date {
            font-size: 18px;
            font-weight: bold;
            color: #333;
            min-width: 200px;
            text-align: center;
        }

        .date-input {
            padding: 8px 12px;
            border: 1px solid #ddd;
            border-radius: 4px;
            font-size: 14px;
        }

        .users-selection {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 15px;
            margin-bottom: 15px;
        }

        .user-checkbox {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px;
            border: 1px solid #ddd;
            border-radius: 4px;
            background-color: #fafafa;
            cursor: pointer;
            transition: all 0.2s;
        }

        .user-checkbox:hover {
            background-color: #f0f0f0;
            border-color: #2196F3;
        }

        .user-checkbox input[type="checkbox"] {
            cursor: pointer;
            width: 18px;
            height: 18px;
        }

        .user-checkbox input[type="checkbox"]:checked + label {
            font-weight: bold;
            color: #2196F3;
        }

        .user-checkbox label {
            cursor: pointer;
            flex-grow: 1;
            margin: 0;
            color: #333;
        }

        .action-buttons {
            display: flex;
            gap: 10px;
            justify-content: center;
            flex-wrap: wrap;
        }

        .btn {
            padding: 10px 20px;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-weight: bold;
            transition: all 0.2s;
        }

        .btn-primary {
            background-color: #2196F3;
            color: white;
        }

        .btn-primary:hover {
            background-color: #0b7dda;
        }

        .btn-secondary {
            background-color: #9e9e9e;
            color: white;
        }

        .btn-secondary:hover {
            background-color: #757575;
        }

        .btn-success {
            background-color: #4CAF50;
            color: white;
        }

        .btn-success:hover {
            background-color: #45a049;
        }

        .summary-table {
            width: 100%;
            border-collapse: collapse;
            background-color: white;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            margin-bottom: 20px;
            white-space: nowrap;
        }

        .summary-table th {
            padding: 6px 2px;
            text-align: center;
            border: 1px solid #999;
            font-weight: bold;
            background-color: #2196F3;
            color: white;
            min-width: 35px;
            font-size: 10px;
        }

        .summary-table td {
            padding: 4px 2px;
            text-align: center;
            border: 1px solid #ddd;
            font-weight: bold;
            font-size: 10px;
            min-width: 35px;
            height: 24px;
            vertical-align: middle;
        }

        .member-header {
            text-align: center;
            background-color: #f5f5f5;
            border-right: 2px solid #999;
            min-width: 100px;
            font-weight: bold;
            color: #333;
            padding: 4px 8px;
            font-size: 12px;
            border: 1px solid #999;
        }

        .day-header {
            background-color: #1565c0;
            color: white;
            border-bottom: 3px solid #0d47a1;
            font-weight: bold;
            text-align: center;
            writing-mode: horizontal-tb;
            padding: 10px !important;
            font-size: 13px;
        }

        .hour-header {
            background-color: #e3f2fd;
            font-size: 8px;
            padding: 2px 1px;
            border: 1px solid #999;
            min-width: 35px;
            height: 20px;
        }

        .activity-cell.d {
            background-color: #c8e6c9;
            color: #333;
        }

        .activity-cell.s {
            background-color: #bbdefb;
            color: #333;
        }

        .activity-cell.oncall {
            background-color: #ffe0b2;
            color: #333;
        }

        .activity-cell.v {
            background-color: #f8bbd0;
            color: #333;
        }

        .activity-cell.h {
            background-color: #ef9a9a;
            color: white;
        }

        .activity-cell.leave {
            background-color: #b0bec5;
            color: #333;
        }

        .activity-cell.shifta { background-color: #a5d6a7; color: #1b5e20; }
        .activity-cell.shiftb { background-color: #80cbc4; color: #004d40; }
        .activity-cell.shiftc { background-color: #90caf9; color: #0d47a1; }
        .activity-cell.shiftd { background-color: #ce93d8; color: #4a148c; }
        .activity-cell.shifte { background-color: #ffcc80; color: #e65100; }

        .activity-cell {
            background-color: #d0d0d0;
            color: #333;
        }

        .activity-cell {
            cursor: pointer;
            transition: all 0.2s;
            font-size: 9px;
            padding: 2px 1px;
            min-height: 20px;
        }

        .activity-cell:hover {
            opacity: 0.8;
            transform: scale(1.08);
        }

        .legend {
            background-color: white;
            border-radius: 8px;
            padding: 15px;
            margin-bottom: 20px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        }

        .legend-title {
            font-weight: bold;
            margin-bottom: 10px;
            color: #333;
        }

        .legend-items {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 10px;
        }

        .legend-item {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .legend-color {
            width: 20px;
            height: 20px;
            border-radius: 3px;
        }

        .back-btn {
            padding: 10px 20px;
            background-color: #9e9e9e;
            color: white;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-weight: bold;
            text-decoration: none;
        }

        .back-btn:hover {
            background-color: #757575;
        }

        .loading {
            text-align: center;
            padding: 40px;
            font-size: 18px;
            color: #666;
        }

        .error-message {
            background-color: #f44336;
            color: white;
            padding: 15px;
            border-radius: 4px;
            margin-bottom: 20px;
        }

        .no-users-message {
            background-color: #fff3cd;
            color: #856404;
            padding: 15px;
            border-radius: 4px;
            margin-bottom: 20px;
        }

        .buttons-container {
            text-align: center;
            margin-top: 20px;
            display: flex;
            gap: 10px;
            justify-content: center;
            flex-wrap: wrap;
        }

        .table-wrapper {
            overflow-x: auto;
            background-color: white;
            border-radius: 8px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            margin: 0;
            display: block;
            width: 100%;
        }

        .date-info {
            font-size: 12px;
            color: #666;
            font-weight: normal;
        }

        .spacing-row {
            background-color: #f9f9f9;
            height: 8px;
        }

        .spacing-row td {
            border: none;
            background-color: #f9f9f9;
            padding: 2px;
        }

        .user-row td {
            background-color: #ffffff;
        }

        .user-row td.member-header {
            background-color: #f0f0f0;
            border-left: 3px solid #1565c0;
            font-weight: 600;
            padding: 4px 8px;
        }
    </style>
</head>
<body>
    <%- include('header') %>

    <div class="container">
        <h1>📅 Team Schedule by Day - Hourly Breakdown</h1>

        <div class="legend">
            <div class="legend-title">Activity Types (Hour Slots: 00-01, 01-02, ... 23-24):</div>
            <div class="legend-items">
                <div class="legend-item">
                    <div class="legend-color" style="background-color: #c8e6c9;"></div>
                    <span>D - Development</span>
                </div>
                <div class="legend-item">
                    <div class="legend-color" style="background-color: #bbdefb;"></div>
                    <span>S - Support</span>
                </div>
                <div class="legend-item">
                    <div class="legend-color" style="background-color: #ffe0b2;"></div>
                    <span>OnCall</span>
                </div>
                <div class="legend-item">
                    <div class="legend-color" style="background-color: #f8bbd0;"></div>
                    <span>V - Vacation</span>
                </div>
                <div class="legend-item">
                    <div class="legend-color" style="background-color: #ef9a9a;"></div>
                    <span>H - Holiday</span>
                </div>
                <div class="legend-item">
                    <div class="legend-color" style="background-color: #b0bec5;"></div>
                    <span>Leave</span>
                </div>
                <div class="legend-item">
                    <div class="legend-color" style="background-color: #a5d6a7;"></div>
                    <span>A - Shift A (02-11)</span>
                </div>
                <div class="legend-item">
                    <div class="legend-color" style="background-color: #80cbc4;"></div>
                    <span>B - Shift B (03-12)</span>
                </div>
                <div class="legend-item">
                    <div class="legend-color" style="background-color: #90caf9;"></div>
                    <span>C - Shift C (07-16)</span>
                </div>
                <div class="legend-item">
                    <div class="legend-color" style="background-color: #ce93d8;"></div>
                    <span>D - Shift D (10-19)</span>
                </div>
                <div class="legend-item">
                    <div class="legend-color" style="background-color: #ffcc80;"></div>
                    <span>E - Shift E (09-18)</span>
                </div>
                <div class="legend-item">
                    <div class="legend-color" style="background-color: #d0d0d0;"></div>
                    <span>Off</span>
                </div>
            </div>
        </div>

        <div class="controls-panel">
            <div class="controls-title">View Options:</div>
            <div class="nav-controls">
                <button class="nav-btn" onclick="location.href='/summary'" style="background-color: #666;">📊 Team by Week</button>
                <button class="nav-btn" style="background-color: #2196F3;">📅 Team by Day (Hourly)</button>
            </div>

            <div class="controls-title">Navigation & Date Selection:</div>
            <div class="nav-controls">
                <button class="nav-btn" onclick="previousWeek()">← Previous Week</button>
                <input type="date" id="dateInput" class="date-input" onchange="loadSummaryByDay()">
                <button class="nav-btn" onclick="nextWeek()">Next Week →</button>
            </div>

            <div class="controls-title" style="margin-top: 20px;">Select Team Members:</div>
            <div class="users-selection" id="usersSelection"></div>

            <div class="action-buttons" style="margin-top: 15px;">
                <button class="btn btn-success" onclick="selectAllUsers()">Select All</button>
                <button class="btn btn-secondary" onclick="clearAllUsers()">Clear All</button>
                <button class="btn btn-primary" onclick="loadSummaryByDay()">Load Summary</button>
            </div>
        </div>

        <div id="errorContainer"></div>
        <div id="loadingContainer" style="display: none;" class="loading">Loading summary...</div>

        <div class="table-wrapper">
            <table class="summary-table" id="summaryTable"></table>
        </div>

        <div class="buttons-container">
            <button class="back-btn" onclick="location.href='/'">Back to Home</button>
        </div>
    </div>

    <script>
        let currentDate = new Date(2026, 5, 9); // June 9, 2026
        let selectedUserIds = [];
        let allUsers = [];
        let scheduleData = {};

        // Shift patterns: index = hour (0-23), value = actual activity
        const SHIFT_PATTERNS = {
            'ShiftA': ['Off','Off','S','S','S','S','S','D','D','D','D','Off','Off','Off','Off','Off','Off','Off','Off','Off','Off','Off','Off','Off'],
            'ShiftB': ['Off','Off','Off','S','S','S','S','S','D','D','D','D','Off','Off','Off','Off','Off','Off','Off','Off','Off','Off','Off','Off'],
            'ShiftC': ['Off','Off','Off','Off','Off','Off','Off','S','S','S','S','S','D','D','D','D','Off','Off','Off','Off','Off','Off','Off','Off'],
            'ShiftD': ['Off','Off','Off','Off','Off','Off','Off','Off','Off','Off','S','S','S','S','D','D','D','D','S','Off','Off','Off','Off','Off'],
            'ShiftE': ['Off','Off','Off','Off','Off','Off','Off','Off','Off','D','D','D','D','S','S','S','S','S','Off','Off','Off','Off','Off','Off']
        };

        // Resolve actual D/S/Off for a given activity + hour
        function resolveHourlyActivity(activity, hour) {
            if (SHIFT_PATTERNS[activity]) {
                return SHIFT_PATTERNS[activity][hour] || 'Off';
            }
            return activity || 'Off';
        }

        document.addEventListener('DOMContentLoaded', function() {
            const today = new Date('2026-06-09');
            currentDate = new Date(today);
            document.getElementById('dateInput').valueAsDate = today;
            loadAllUsers();
        });

        function loadAllUsers() {
            fetch('/api/proxy/schedule/all-users')
                .then(res => res.json())
                .then(users => {
                    allUsers = users;
                    renderUserCheckboxes();
                    
                    // Try to load saved selection from localStorage
                    const savedIds = localStorage.getItem('selected_team_members');
                    let idsToSelect = [];
                    
                    if (savedIds) {
                        try {
                            const parsedIds = JSON.parse(savedIds);
                            // Only select users that still exist in the allUsers list
                            idsToSelect = parsedIds.filter(id => users.some(u => u.id === id));
                        } catch (e) {
                            console.error('Error parsing saved users:', e);
                        }
                    }
                    
                    // If no saved selection or all saved users no longer exist, select first 3 as default
                    if (idsToSelect.length === 0) {
                        const defaultCount = Math.min(3, users.length);
                        for (let i = 0; i < defaultCount; i++) {
                            idsToSelect.push(users[i].id);
                        }
                    }
                    
                    idsToSelect.forEach(id => toggleUser(id, true));
                    loadSummaryByDay();
                })
                .catch(err => {
                    console.error('Error loading users:', err);
                    showError('Failed to load team members');
                });
        }

        function renderUserCheckboxes() {
            const container = document.getElementById('usersSelection');
            container.innerHTML = '';

            allUsers.forEach(user => {
                const div = document.createElement('div');
                div.className = 'user-checkbox';
                div.innerHTML = `
                    <input type="checkbox" id="user-${user.id}" onchange="toggleUser(${user.id}, this.checked)">
                    <label for="user-${user.id}">${user.username}</label>
                `;
                container.appendChild(div);
            });
        }

        function toggleUser(userId, checked) {
            if (checked) {
                if (!selectedUserIds.includes(userId)) {
                    selectedUserIds.push(userId);
                }
                const checkbox = document.getElementById(`user-${userId}`);
                if (checkbox) checkbox.checked = true;
            } else {
                selectedUserIds = selectedUserIds.filter(id => id !== userId);
                const checkbox = document.getElementById(`user-${userId}`);
                if (checkbox) checkbox.checked = false;
            }
            saveSelection();
        }

        function saveSelection() {
            localStorage.setItem('selected_team_members', JSON.stringify(selectedUserIds));
        }

        function selectAllUsers() {
            allUsers.forEach(user => toggleUser(user.id, true));
        }

        function clearAllUsers() {
            allUsers.forEach(user => toggleUser(user.id, false));
            selectedUserIds = [];
        }

        function getWeekStart(date) {
            const d = new Date(date);
            const day = d.getDay();
            const diff = d.getDate() - day + 1; // Monday start
            return new Date(d.setDate(diff));
        }

        function loadSummaryByDay() {
            scheduleData = {};  // Reset stale data before loading
            if (selectedUserIds.length === 0) {
                const msg = 'Please select at least one team member';
                showError(msg);
                console.warn(msg);
                document.getElementById('summaryTable').innerHTML = '';
                return;
            }

            const dateInput = document.getElementById('dateInput');
            const selectedDateStr = dateInput.value;
            if (!selectedDateStr) {
                showError('Please select a date');
                return;
            }

            const baseDate = new Date(selectedDateStr + 'T00:00:00');
            const weekStart = getWeekStart(baseDate);

            document.getElementById('loadingContainer').style.display = 'block';
            document.getElementById('summaryTable').innerHTML = '';
            document.getElementById('errorContainer').innerHTML = '';

            console.log('Loading summary for week starting:', formatDate(weekStart), 'Selected users:', selectedUserIds);

            // Load hourly data for each selected user for each day of the week
            const promises = [];

            for (let i = 0; i < 7; i++) {
                const date = new Date(weekStart);
                date.setDate(date.getDate() + i);
                const dateStr = formatDate(date);

                selectedUserIds.forEach(userId => {
                    promises.push(
                        fetch(`/api/proxy/schedule/day/${userId}/hours?date=${dateStr}`)
                            .then(res => {
                                if (!res.ok) {
                                    throw new Error(`HTTP error! status: ${res.status}`);
                                }
                                return res.json();
                            })
                            .then(data => {
                                if (!scheduleData[userId]) scheduleData[userId] = {};
                                // Ensure data is an array
                                const entries = Array.isArray(data) ? data : (data && data.data ? data.data : []);
                                scheduleData[userId][dateStr] = entries;
                                console.log(`✓ Loaded ${entries.length} entries for user ${userId} on ${dateStr}`);
                            })
                            .catch(err => {
                                console.error('✗ Error loading hourly data for user', userId, 'on', dateStr, err);
                                showError(`Failed to load schedule for user ${userId} on ${dateStr}`);
                            })
                    );
                });
            }

            Promise.all(promises)
                .then(() => {
                    console.log('All data loaded, rendering...');
                    document.getElementById('loadingContainer').style.display = 'none';
                    renderSummaryByDay(weekStart);
                })
                .catch(err => {
                    console.error('Promise.all error:', err);
                    document.getElementById('loadingContainer').style.display = 'none';
                    showError('Failed to load team summary: ' + err.message);
                });
        }

        function renderSummaryByDay(weekStart) {
            const table = document.getElementById('summaryTable');
            let html = '';

            // Render each day of the week
            for (let dayIndex = 0; dayIndex < 7; dayIndex++) {
                const date = new Date(weekStart);
                date.setDate(date.getDate() + dayIndex);
                const dateStr = formatDate(date);
                const dayName = date.toLocaleDateString('en-US', { weekday: 'long' });

                // Day header row with day name and date
                html += '<tr>';
                html += `<th colspan="25" class="day-header">📅 ${dayName} - ${dateStr}</th>`;
                html += '</tr>';

                // Hour header row
                html += '<tr>';
                html += '<th class="member-header" style="background-color: #f5f5f5; font-weight: bold; font-size: 11px;">User</th>';
                for (let hour = 0; hour < 24; hour++) {
                    const startHour = String(hour).padStart(2, '0');
                    const endHour = String(hour + 1).padStart(2, '0');
                    html += `<th class="hour-header">${startHour}-${endHour}</th>`;
                }
                html += '</tr>';

                // User rows for this day
                selectedUserIds.forEach(userId => {
                    const user = allUsers.find(u => u.id === userId);
                    const userName = user ? user.username : 'Unknown';
                    const dayEntries = scheduleData[userId] ? (scheduleData[userId][dateStr] || []) : [];

                    // Validate dayEntries is an array
                    if (!Array.isArray(dayEntries)) {
                        console.warn('dayEntries is not an array for user', userId, dayEntries);
                        return;
                    }

                    html += '<tr class="user-row">';
                    html += `<td class="member-header">${userName}</td>`;

                    for (let hour = 0; hour < 24; hour++) {
                        const entry = dayEntries.find(e => {
                            const hourValue = e.hourOfDay !== undefined ? e.hourOfDay : e.hour;
                            return hourValue === hour;
                        });
                        const rawActivity = entry ? entry.activity : 'Off';
                        const activity = resolveHourlyActivity(rawActivity, hour);
                        const activityClass = activity.toLowerCase();

                        html += `<td class="activity-cell ${activityClass}">${activity}</td>`;
                    }

                    html += '</tr>';
                });

                // Add a spacing row between days
                if (dayIndex < 6) {
                    html += '<tr class="spacing-row"><td colspan="25"></td></tr>';
                }
            }

            console.log('Rendering table with HTML length:', html.length);
            table.innerHTML = html;
            console.log('Table rendered successfully');
        }

        function previousWeek() {
            const dateInput = document.getElementById('dateInput');
            const date = new Date(dateInput.value + 'T00:00:00');
            date.setDate(date.getDate() - 7);
            dateInput.valueAsDate = date;
            loadSummaryByDay();
        }

        function nextWeek() {
            const dateInput = document.getElementById('dateInput');
            const date = new Date(dateInput.value + 'T00:00:00');
            date.setDate(date.getDate() + 7);
            dateInput.valueAsDate = date;
            loadSummaryByDay();
        }

        function formatDate(date) {
            const year = date.getFullYear();
            const month = String(date.getMonth() + 1).padStart(2, '0');
            const day = String(date.getDate()).padStart(2, '0');
            return `${year}-${month}-${day}`;
        }

        function showError(message) {
            const errorContainer = document.getElementById('errorContainer');
            errorContainer.innerHTML = `<div class="error-message">⚠️ ${message}</div>`;
            console.error('Error:', message);
        }
    </script>
</body>
</html>

