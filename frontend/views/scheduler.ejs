          function saveActivityEntry(dateStr, activity, notes) {
              if (isShiftType(activity)) {
                  return expandAndSaveShift(dateStr, activity, notes);
              }
              fetch(`/api/proxy/schedule/${CURRENT_USER_ID}`, {
                  method: 'POST',
                  headers: {
                      'Content-Type': 'application/json'
                  },
                  body: JSON.stringify({
                      date: dateStr,
                      activity: activity,
                      isOnCall: activity === 'OnCall',
                      notes: notes || ''
                  })
              })
              .then(res => res.json())
              .then(savedEntry => {
                  // Update local scheduleData with the saved entry
                  scheduleData[dateStr] = savedEntry;

                  // Increment pending saves
                  pendingSaves++;

                  // Clear previous timeout
                  if (toastTimeout) {
                      clearTimeout(toastTimeout);
                  }

                  // Set new debounced toast
                  toastTimeout = setTimeout(() => {
                      if (pendingSaves > 0) {
                          const message = pendingSaves === 1
                              ? '1 entry saved'
                              : `${pendingSaves} entries saved`;
                          showToast(message);
                          pendingSaves = 0;
                      }
                  }, TOAST_DEBOUNCE_DELAY);

                  // Refresh current view to ensure consistency
                  const activeView = Array.from(document.querySelectorAll('.view-btn')).find(btn => btn.classList.contains('active'));
                  if (activeView) {
                      const viewName = activeView.textContent.toLowerCase();
                      if (viewName.includes('month')) {
                          loadMonth();
                      } else if (viewName.includes('week')) {
                          loadWeek();
                      } else if (viewName.includes('day')) {
                          loadDay();
                      } else if (viewName.includes('year')) {
                          loadYear();
                      }
                  }
              })
              .catch(err => {
                  console.error('Error saving activity:', err);
                  showToast('Error saving data!', 'error');
              });
          }

         function showToast(message, type = 'success') {
             // Remove any existing toast
             const existingToast = document.querySelector('.toast-notification');
             if (existingToast) {
                 existingToast.classList.add('hide');
                 setTimeout(() => existingToast.remove(), 300);
             }

             // Create new toast
             const toast = document.createElement('div');
             toast.className = 'toast-notification';
             toast.textContent = message;
             if (type === 'error') {
                 toast.style.backgroundColor = '#f44336';
             }
             document.body.appendChild(toast);

             // Auto remove after 7 seconds
             setTimeout(() => {
                 toast.classList.add('hide');
                 setTimeout(() => toast.remove(), 300);
             }, TOAST_DISPLAY_DELAY);
         }

        function formatDate(date) {
            const year = date.getFullYear();
            const month = String(date.getMonth() + 1).padStart(2, '0');
            const day = String(date.getDate()).padStart(2, '0');
            return `${year}-${month}-${day}`;
        }

        // Close modal when clicking outside
        window.onclick = function(event) {
            const modal = document.getElementById('editModal');
            if (event.target === modal) {
                closeModal();
            }
        }

        // 24-Hour Hourly View Functions
        function loadHourly() {
            const dateInput = document.getElementById('hourlyInput');
            const dateStr = dateInput.value;

            if (!dateStr) return;

            fetch(`/api/proxy/schedule/day/${CURRENT_USER_ID}/hours?date=${dateStr}`)
                .then(res => res.json())
                .then(data => {
                    scheduleData = {};
                    data.forEach(entry => {
                        const key = `${entry.date}-${entry.hourOfDay}`;
                        scheduleData[key] = entry;
                    });
                    renderHourly(dateStr);
                })
                .catch(err => console.error('Error fetching hourly schedule:', err));
        }

        function renderHourly(dateStr) {
            const dateObj = new Date(dateStr + 'T00:00:00');
            const dayName = dateObj.toLocaleDateString('en-US', { weekday: 'long' });

            // Build header with 24 hour slots (all columns)
            const thead = document.getElementById('hourlyTableHead');
            thead.innerHTML = '';
            const headerRow = document.createElement('tr');
            headerRow.innerHTML = `<th style="width: 150px; min-width: 150px;">Date / User</th>`;

            for (let hour = 0; hour < 24; hour++) {
                const startHour = String(hour).padStart(2, '0');
                const endHour = String(hour + 1).padStart(2, '0');
                headerRow.innerHTML += `<th style="min-width: 40px; padding: 8px 4px; font-size: 11px;">${startHour}-${endHour}</th>`;
            }
            thead.appendChild(headerRow);

            // Build single body row with all 24 hours as columns
            const tbody = document.getElementById('hourlyTableBody');
            tbody.innerHTML = '';

            const tr = document.createElement('tr');

            // First cell: Date and day name
            const dateCell = document.createElement('td');
            dateCell.style.backgroundColor = '#f5f5f5';
            dateCell.style.fontWeight = 'bold';
            dateCell.style.textAlign = 'left';
            dateCell.style.minWidth = '150px';
            dateCell.innerHTML = `${dateStr}<br>${dayName}`;
            tr.appendChild(dateCell);

              // Add all 24 hours as cells in the same row
              for (let hour = 0; hour < 24; hour++) {
                  const key = `${dateStr}-${hour}`;
                  const entry = scheduleData[key] || { activity: 'D', notes: '', isOnCall: false };

                  let activityClass = getActivityClass(entry.activity);
                  const oncallClass = entry.activity === 'OnCall' ? 'oncall' : '';
                  const displayActivity = getActivityDisplay(entry.activity);

                  const td = document.createElement('td');
                  td.className = `activity-cell ${activityClass}`;
                  td.innerHTML = displayActivity;
                  td.style.cursor = 'pointer';
                  td.style.padding = '12px 4px';
                  td.style.textAlign = 'center';
                  td.style.minWidth = '40px';
                  td.style.fontWeight = 'bold';
                  td.style.position = 'relative';
                   td.onclick = () => openHourlyModal(dateStr, hour, entry.activity, entry.notes || '');
                  tr.appendChild(td);
              }

            tbody.appendChild(tr);
        }

           function openHourlyModal(dateStr, hour, activity, notes) {
               selectedDateForModal = dateStr;
               document.getElementById('modalDate').value = `${dateStr} (${String(hour).padStart(2, '0')}-${String(hour + 1).padStart(2, '0')})`;
               document.getElementById('modalActivity').value = activity;
               document.getElementById('modalNotes').value = notes || '';

              // Store the hour in the local variable
              selectedHourForModal = hour;

              // Update active button
              const buttons = document.querySelectorAll('.activity-btn');
              buttons.forEach(btn => btn.classList.remove('active'));

              let activityClass = getActivityClass(activity);
              const classSel3 = activityClass.trim().split(/\s+/).map(c => '.' + c).join('');
              const activeBtn = document.querySelector(`.activity-btn${classSel3}`);
              if (activeBtn) {
                  activeBtn.classList.add('active');
              }

              document.getElementById('editModal').style.display = 'block';
          }

        function previousHourlyDay() {
            const dateInput = document.getElementById('hourlyInput');
            const date = new Date(dateInput.valueAsDate);
            date.setDate(date.getDate() - 1);
            dateInput.valueAsDate = date;
            loadHourly();
        }

        function nextHourlyDay() {
            const dateInput = document.getElementById('hourlyInput');
            const date = new Date(dateInput.valueAsDate);
            date.setDate(date.getDate() + 1);
            dateInput.valueAsDate = date;
            loadHourly();
        }

         // Override saveModalChanges to support hourly saves
         const originalSaveModalChanges = saveModalChanges;
         window.saveModalChanges = function() {
             const activity = document.getElementById('modalActivity').value;
             const notes = document.getElementById('modalNotes').value;
             const hour = selectedHourForModal;

             // If a shift type is selected, always expand to full day pattern
             if (isShiftType(activity)) {
                 expandAndSaveShift(selectedDateForModal, activity, notes);
                 closeModal();
                 selectedHourForModal = null;
                 return;
             }

             // Build request body - only include hour if it's defined (hourly view mode)
             const requestBody = {
                 date: selectedDateForModal,
                 activity: activity,
                 isOnCall: activity === 'OnCall',
                 notes: notes
             };

             // Only include hour if we're in hourly edit mode
             if (hour !== undefined && hour !== null) {
                 requestBody.hour = hour;
             }

             fetch(`/api/proxy/schedule/${CURRENT_USER_ID}`, {
                 method: 'POST',
                 headers: {
                     'Content-Type': 'application/json'
                 },
                 body: JSON.stringify(requestBody)
             })
             .then(res => res.json())
             .then(savedEntry => {
                 // Use the correct key based on whether hour is defined
                 const key = hour !== undefined && hour !== null ? `${selectedDateForModal}-${hour}` : selectedDateForModal;
                 scheduleData[key] = savedEntry;
                 closeModal();

                 // Reset selectedHourForModal after saving
                 selectedHourForModal = null;

                 pendingSaves++;

                 if (toastTimeout) {
                     clearTimeout(toastTimeout);
                 }

                 toastTimeout = setTimeout(() => {
                     if (pendingSaves > 0) {
                         const message = pendingSaves === 1
                             ? '1 entry saved'
                             : `${pendingSaves} entries saved`;
                         showToast(message);
                         pendingSaves = 0;
                     }
                 }, TOAST_DEBOUNCE_DELAY);

                 // Reload current view to show changes
                 const activeView = Array.from(document.querySelectorAll('.view-btn')).find(btn => btn.classList.contains('active'));
                 if (activeView) {
                     const viewName = activeView.textContent.toLowerCase();
                     if (viewName.includes('24-hour')) {
                         loadHourly();
                     } else {
                         activeView.click();
                     }
                 }
             })
             .catch(err => {
                 console.error('Error saving schedule:', err);
                 alert('Error saving schedule entry');
             });
         };

    </script>
</body>
</html>

