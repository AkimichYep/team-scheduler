<!DOCTYPE html>
<%- include('header', { activePage: 'scheduler' }) %>

<link rel="stylesheet" href="/css/scheduler.css">

<div class="container scheduler-page">
    <div class="card">
        <div class="header-with-actions">
            <h1>My Scheduler</h1>
        </div>

        <div class="legend">
            <div class="legend-title">Activity Types:</div>
            <div class="legend-items">
                <div class="legend-item"><div class="legend-color" style="background-color: #c8e6c9;"></div><span>D - Development</span></div>
                <div class="legend-item"><div class="legend-color" style="background-color: #bbdefb;"></div><span>S - Support</span></div>
                <div class="legend-item"><div class="legend-color" style="background-color: #ffe0b2;"></div><span>OnCall</span></div>
                <div class="legend-item"><div class="legend-color" style="background-color: #d0d0d0;"></div><span>Off</span></div>
                <div class="legend-item"><div class="legend-color" style="background-color: #f8bbd0;"></div><span>V - Vacation</span></div>
                <div class="legend-item"><div class="legend-color" style="background-color: #ef9a9a;"></div><span>H - Holiday</span></div>
                <div class="legend-item"><div class="legend-color" style="background-color: #b0bec5;"></div><span>Leave</span></div>
                <div class="legend-item"><div class="legend-color" style="background-color: #a5d6a7;"></div><span>A - Shift A</span></div>
                <div class="legend-item"><div class="legend-color" style="background-color: #80cbc4;"></div><span>B - Shift B</span></div>
                <div class="legend-item"><div class="legend-color" style="background-color: #90caf9;"></div><span>C - Shift C</span></div>
                <div class="legend-item"><div class="legend-color" style="background-color: #ce93d8;"></div><span>D - Shift D</span></div>
                <div class="legend-item"><div class="legend-color" style="background-color: #ffcc80;"></div><span>E - Shift E</span></div>
                <div class="legend-item"><span>&lt; A - OnCall Start</span></div>
                <div class="legend-item"><span>A &gt; - OnCall End</span></div>
                <div class="legend-item"><span>&lt; A &gt; - Both</span></div>
            </div>
        </div>

        <div class="view-selector">
            <button class="view-btn active" onclick="switchView('month')">Month View</button>
            <button class="view-btn" onclick="switchView('year')">Year View</button>
        </div>

        <%- include('partials/scheduler-month-view') %>
        <%- include('partials/scheduler-year-view') %>

        <div class="buttons-container">
            <button class="back-btn" onclick="location.href='/'">Back</button>
        </div>
    </div>

    <%- include('partials/scheduler-modal') %>
</div>

<script>
    window.CURRENT_USER_ID = '<%= userId %>';
</script>
<script src="/js/scheduler.js"></script>
