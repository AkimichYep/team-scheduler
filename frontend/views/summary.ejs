<html>
<head>
    <title>Team Summary - Team Scheduler</title>
    <link rel="stylesheet" href="/css/style.css">
    <script src="/js/shift-patterns.js"></script>
    <script src="/js/common-utils.js"></script>
</head>
<body>
    <%- include('header', { activePage: 'summary' }) %>

    <div class="container summary-page">
        <header class="page-header">
            <h1>Team Summary <span class="subtitle">- Weekly Overview</span></h1>
        </header>

        <div class="card legend-card">
            <h3>Activity Legend</h3>
            <div class="legend-grid">
                <div class="legend-item"><span class="color-box d"></span> D - Development</div>
                <div class="legend-item"><span class="color-box s"></span> S - Support</div>
                <div class="legend-item"><span class="color-box oncall"></span> OnCall</div>
                <div class="legend-item"><span class="color-box v"></span> V - Vacation</div>
                <div class="legend-item"><span class="color-box h"></span> H - Holiday</div>
                <div class="legend-item"><span class="color-box leave"></span> Leave</div>
                <div class="legend-item"><span class="color-box shifta"></span> Shift A (02-11)</div>
                <div class="legend-item"><span class="color-box shiftb"></span> Shift B (03-12)</div>
                <div class="legend-item"><span class="color-box shiftc"></span> Shift C (07-16)</div>
                <div class="legend-item"><span class="color-box shiftd"></span> Shift D (10-19)</div>
                <div class="legend-item"><span class="color-box shifte"></span> Shift E (09-18)</div>
                <div class="legend-item"><span class="color-box off"></span> Off</div>
            </div>
        </div>

        <div class="card controls-card">
            <div class="controls-row">
                <div class="control-group view-toggle">
                    <a href="/summary" class="btn btn-primary active-view">📊 Team by Week</a>
                    <a href="/summary-by-day" class="btn btn-secondary">📅 Team by Day (Hourly)</a>
                </div>
                <div class="control-group date-nav">
                    <button class="btn btn-primary" onclick="previousMonth()">← Prev Month</button>
                    <button class="btn btn-primary" onclick="nextMonth()">Next Month →</button>
                </div>
            </div>

            <div class="member-selection-area">
                <h4>Select Team Members</h4>
                <div class="users-grid" id="usersSelection"></div>
                <div class="selection-actions">
                    <button class="btn btn-secondary btn-sm" onclick="selectAllUsers()">Select All</button>
                    <button class="btn btn-danger btn-sm" onclick="clearAllUsers()">Clear All</button>
                    <button class="btn btn-accent" onclick="loadSummary()">Load Summary</button>
                </div>
            </div>
        </div>

        <div id="errorContainer"></div>
        <div id="loadingContainer" class="loading-overlay" style="display: none;">
            <div class="spinner"></div>
            <p>Gathering team data...</p>
        </div>

        <div id="summaryContainer" style="overflow-x: auto;"></div>
    </div>

    <style>
        .summary-page { max-width: 100%; }
        .page-header h1 { color: var(--primary-color); margin-bottom: 25px; }
        .subtitle { font-weight: normal; font-size: 0.7em; color: #666; }
        
        .legend-card h3 { margin-top: 0; font-size: 1.1em; }
        .legend-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 10px; font-size: 0.85em; }
        .legend-item { display: flex; align-items: center; gap: 8px; }
        .color-box { width: 16px; height: 16px; border-radius: 3px; border: 1px solid rgba(0,0,0,0.1); }
        .color-box.d { background-color: #c8e6c9; }
        .color-box.s { background-color: #bbdefb; }
        .color-box.oncall { background-color: #ffe0b2; }
        .color-box.v { background-color: #f8bbd0; }
        .color-box.h { background-color: #ef9a9a; }
        .color-box.leave { background-color: #b0bec5; }
        .color-box.shifta { background-color: #a5d6a7; }
        .color-box.shiftb { background-color: #80cbc4; }
        .color-box.shiftc { background-color: #90caf9; }
        .color-box.shiftd { background-color: #ce93d8; }
        .color-box.shifte { background-color: #ffcc80; }
        .color-box.off { background-color: #d0d0d0; }

        .controls-card { margin-top: 20px; }
        .controls-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; flex-wrap: wrap; gap: 15px; }
        .view-toggle, .date-nav { display: flex; gap: 10px; }
        
        .member-selection-area h4 { margin: 0 0 15px 0; border-top: 1px solid #eee; padding-top: 15px; }
        .users-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 10px; margin-bottom: 20px; }
        .user-checkbox-item { display: flex; align-items: center; gap: 8px; padding: 8px; background: #f9f9f9; border-radius: 4px; cursor: pointer; transition: background 0.2s; }
        .user-checkbox-item:hover { background: #eee; }
        .user-checkbox-item input { width: 16px; height: 16px; margin: 0; }
        .selection-actions { display: flex; gap: 10px; justify-content: center; }
        .btn-sm { padding: 6px 12px; font-size: 0.85em; }

        .summary-table { width: 100%; border-collapse: collapse; font-size: 0.85em; background: white; margin-bottom: 40px; box-shadow: var(--shadow); border-radius: 8px; table-layout: fixed; min-width: 1200px; }
        .month-title { color: var(--primary-dark); margin: 30px 0 15px 0; border-left: 5px solid var(--primary-color); padding-left: 15px; }
        .week-header { background-color: var(--primary-color); color: white; padding: 10px; font-weight: bold; border: 1px solid rgba(255,255,255,0.2); }
        .date-number-row td { background-color: #f0f7ff; color: #555; padding: 8px 4px; border: 1px solid #e0e0e0; font-size: 0.9em; line-height: 1.2; }
        .member-header { background-color: #f9f9f9; font-weight: bold; text-align: left; padding: 10px 15px; border: 1px solid #e0e0e0; width: 140px; position: sticky; left: 0; z-index: 10; }
        .activity-cell { height: 45px; border: 1px solid #eee; text-align: center; font-weight: bold; }
        
        .activity-cell.d { background-color: #e8f5e9; color: #2e7d32; }
        .activity-cell.s { background-color: #e3f2fd; color: #1565c0; }
        .activity-cell.oncall { background-color: #fff3e0; color: #e65100; }
        .activity-cell.v { background-color: #fce4ec; color: #c2185b; }
        .activity-cell.h { background-color: #ffebee; color: #c62828; }
        .activity-cell.leave { background-color: #eceff1; color: #455a64; }
        .activity-cell.shifta { background-color: #a5d6a7; }
        .activity-cell.shiftb { background-color: #80cbc4; }
        .activity-cell.shiftc { background-color: #90caf9; }
        .activity-cell.shiftd { background-color: #ce93d8; }
        .activity-cell.shifte { background-color: #ffcc80; }
        .activity-cell.off { background-color: #f5f5f5; color: #999; }
        
        .activity-cell.oc-pre { border-left: 4px solid #ff9800 !important; }
        .activity-cell.oc-suf { border-right: 4px solid #ff9800 !important; }
        .activity-cell.oc-both { border-left: 4px solid #ff9800 !important; border-right: 4px solid #ff9800 !important; }

        .loading-overlay { text-align: center; padding: 40px; }
        .spinner { width: 40px; height: 40px; border: 4px solid #f3f3f3; border-top: 4px solid var(--primary-color); border-radius: 50%; margin: 0 auto 15px; animation: spin 1s linear infinite; }
        @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
        .view-toggle .btn.active-view {
            background-color: var(--primary-dark);
            cursor: default;
            pointer-events: none;
        }
    </style>

    <script>
        let currentDate = new Date(2026, 0, 1);
        let selectedUserIds = [];
        let allUsers = [];
        let scheduleCache = {}; // Cache: key = "year:month:userIds" -> data

        // Cache utility functions
        function getCacheKey(year, month, userIds) {
            const sorted = [...userIds].sort().join(',');
            return `${year}:${month}:${sorted}`;
        }

        function getCachedData(year, month, userIds) {
            const key = getCacheKey(year, month, userIds);
            return scheduleCache[key] || null;
        }

        function setCachedData(year, month, userIds, data) {
            const key = getCacheKey(year, month, userIds);
            scheduleCache[key] = data;
        }

        function clearCache() {
            scheduleCache = {};
        }

        // Expand grouped entries (with hourRange) into individual hour entries
        function expandGroupedEntries(groupedEntries) {
            const expanded = [];
            if (!groupedEntries || !Array.isArray(groupedEntries)) return expanded;

            groupedEntries.forEach(entry => {
                if (!entry) return;
                
                if (entry.hourRange) {
                    // Parse hourRange: "0" or "0-3" or "10-23"
                    const parts = entry.hourRange.split('-');
                    const startHour = parseInt(parts[0]);
                    const endHour = parts.length > 1 ? parseInt(parts[1]) : startHour;

                    // Validate hours
                    if (isNaN(startHour) || isNaN(endHour) || startHour < 0 || endHour > 23 || startHour > endHour) {
                        console.warn('Invalid hourRange:', entry.hourRange);
                        return;
                    }

                    for (let hour = startHour; hour <= endHour; hour++) {
                        expanded.push({
                            date: entry.date,
                            hourOfDay: hour,
                            activity: entry.activity || 'Off',
                            isOnCall: entry.isOnCall || false,
                            onCallMorning: entry.onCallMorning || false,
                            onCallNight: entry.onCallNight || false,
                            notes: entry.notes || ''
                        });
                    }
                } else if (entry.hourOfDay !== undefined) {
                    expanded.push(entry);
                }
            });
            return expanded;
        }

        // SHIFT_PATTERNS and shift pattern utilities are now loaded from shift-patterns.js

        // getActivityClass, getActivityDisplay, and getDominantActivity
        // are now loaded from shift-patterns.js

        document.addEventListener('DOMContentLoaded', function() {
            const today = new Date('2026-06-09');
            currentDate = new Date(today);
            loadAllUsers();
        });

        function loadAllUsers() {
            fetch('/api/proxy/schedule/all-users')
                .then(res => res.json())
                .then(users => {
                    allUsers = users;
                    renderUserCheckboxes();
                    
                    // Try to load saved selection from localStorage
                    const savedIds = localStorage.getItem('selected_team_members');
                    let idsToSelect = [];
                    
                    if (savedIds) {
                        try {
                            const parsedIds = JSON.parse(savedIds);
                            // Only select users that still exist in the allUsers list
                            idsToSelect = parsedIds.filter(id => users.some(u => u.id === id));
                        } catch (e) {
                            console.error('Error parsing saved users:', e);
                        }
                    }
                    
                    // If no saved selection or all saved users no longer exist, select first 3 as default
                    if (idsToSelect.length === 0) {
                        const defaultCount = Math.min(3, users.length);
                        for (let i = 0; i < defaultCount; i++) {
                            idsToSelect.push(users[i].id);
                        }
                    }
                    
                    idsToSelect.forEach(id => toggleUser(id, true));
                    loadSummary();
                })
                .catch(err => {
                    console.error('Error loading users:', err);
                    showError('Failed to load team members');
                });
        }

        function renderUserCheckboxes() {
            const container = document.getElementById('usersSelection');
            container.innerHTML = '';

            allUsers.forEach(user => {
                const div = document.createElement('div');
                div.className = 'user-checkbox-item';
                div.innerHTML = `
                    <input type="checkbox" id="user-${user.id}" onchange="toggleUser(${user.id}, this.checked)">
                    <label for="user-${user.id}">${user.username}</label>
                `;
                container.appendChild(div);
            });
        }

        function toggleUser(userId, checked) {
            if (checked) {
                if (!selectedUserIds.includes(userId)) {
                    selectedUserIds.push(userId);
                }
                const checkbox = document.getElementById(`user-${userId}`);
                if (checkbox) checkbox.checked = true;
            } else {
                selectedUserIds = selectedUserIds.filter(id => id !== userId);
                const checkbox = document.getElementById(`user-${userId}`);
                if (checkbox) checkbox.checked = false;
            }
            clearCache(); // Clear cache when user selection changes
            saveSelection();
        }

        function saveSelection() {
            localStorage.setItem('selected_team_members', JSON.stringify(selectedUserIds));
        }

        function selectAllUsers() {
            allUsers.forEach(user => toggleUser(user.id, true));
        }

        function clearAllUsers() {
            allUsers.forEach(user => toggleUser(user.id, false));
            selectedUserIds = [];
        }

        function previousMonth() {
            currentDate.setMonth(currentDate.getMonth() - 1);
            const year = currentDate.getFullYear();
            const month = currentDate.getMonth() + 1;
            document.getElementById('pageTitle').textContent = `Team Summary by Week - ${year}`;
            loadSummary();
        }

        function nextMonth() {
            currentDate.setMonth(currentDate.getMonth() + 1);
            const year = currentDate.getFullYear();
            const month = currentDate.getMonth() + 1;
            document.getElementById('pageTitle').textContent = `Team Summary by Week - ${year}`;
            loadSummary();
        }

        function loadSummary() {
            if (selectedUserIds.length === 0) {
                showError('Please select at least one team member');
                document.getElementById('summaryContainer').innerHTML = '';
                return;
            }

            const year = currentDate.getFullYear();
            const month = currentDate.getMonth() + 1;

            document.getElementById('loadingContainer').style.display = 'block';
            document.getElementById('summaryContainer').innerHTML = '';
            document.getElementById('errorContainer').innerHTML = '';

            // Prepare months to fetch (prev, current, next)
            const monthsToFetch = [];
            const results = [];

            // Previous month
            const prevDate = new Date(year, month - 2, 1);
            const prevYear = prevDate.getFullYear();
            const prevMonth = prevDate.getMonth() + 1;
            const prevCached = getCachedData(prevYear, prevMonth, selectedUserIds);
            if (prevCached) {
                results.push({month: prevMonth, year: prevYear, data: prevCached});
            } else {
                monthsToFetch.push({year: prevYear, month: prevMonth});
            }

            // Current month
            const currCached = getCachedData(year, month, selectedUserIds);
            if (currCached) {
                results.push({month: month, year: year, data: currCached});
            } else {
                monthsToFetch.push({year: year, month: month});
            }

            // Next month
            const nextDate = new Date(year, month, 1);
            const nextYear = nextDate.getFullYear();
            const nextMonth = nextDate.getMonth() + 1;
            const nextCached = getCachedData(nextYear, nextMonth, selectedUserIds);
            if (nextCached) {
                results.push({month: nextMonth, year: nextYear, data: nextCached});
            } else {
                monthsToFetch.push({year: nextYear, month: nextMonth});
            }

            // If nothing to fetch, render cached results
            if (monthsToFetch.length === 0) {
                document.getElementById('loadingContainer').style.display = 'none';
                results.sort((a, b) => {
                    if (a.year !== b.year) return a.year - b.year;
                    return a.month - b.month;
                });
                renderAllMonths(results);
                return;
            }

            // Fetch only missing months
            const promises = monthsToFetch.map(({year, month}) => {
                const params = new URLSearchParams();
                params.append('year', year);
                params.append('month', month);
                selectedUserIds.forEach(id => params.append('userIds', id));
                return fetch(`/api/proxy/schedule/team/month/${year}/${month}?${params}`)
                    .then(res => res.json())
                    .then(data => {
                        // Expand grouped entries for all users
                        const expandedData = {};
                        for (const userId in data) {
                            expandedData[userId] = expandGroupedEntries(data[userId]);
                        }
                        setCachedData(year, month, selectedUserIds, expandedData);
                        return {month, year, data: expandedData};
                    });
            });

            Promise.all(promises)
                .then(fetchedResults => {
                    // Combine cached and fetched results
                    const allResults = results.concat(fetchedResults);
                    allResults.sort((a, b) => {
                        if (a.year !== b.year) return a.year - b.year;
                        return a.month - b.month;
                    });
                    document.getElementById('loadingContainer').style.display = 'none';
                    renderAllMonths(allResults);
                })
                .catch(err => {
                    console.error('Error loading summary:', err);
                    document.getElementById('loadingContainer').style.display = 'none';
                    showError('Failed to load team summary');
                });
        }

        function renderAllMonths(results) {
            let html = '';

            results.forEach(result => {
                html += `<div class="month-section">`;
                html += renderTeamSummaryTable(result.data, result.year, result.month);
                html += `</div>`;
            });

            document.getElementById('summaryContainer').innerHTML = html;
        }

        function renderTeamSummaryTable(teamData, year, month) {
            const monthNames = ['January', 'February', 'March', 'April', 'May', 'June',
                              'July', 'August', 'September', 'October', 'November', 'December'];

            // Get all dates for the month
            const lastDay = new Date(year, month, 0);
            const endDate = lastDay.getDate();

            // Get week number for a date
            function getWeekNumber(date) {
                const d = new Date(Date.UTC(date.getFullYear(), date.getMonth(), date.getDate()));
                const dayNum = d.getUTCDay() || 7;
                d.setUTCDate(d.getUTCDate() + 4 - dayNum);
                const yearStart = new Date(Date.UTC(d.getUTCFullYear(), 0, 1));
                return Math.ceil((((d - yearStart) / 86400000) + 1) / 7);
            }

            // Get day name
            function getDayName(day) {
                const d = new Date(year, month - 1, day);
                const names = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
                return names[d.getDay()];
            }

            // Map dates to weeks and collect week info
            let weekInfo = [];
            let currentWeekNum = null;
            let weekStart = 1;

            for (let day = 1; day <= endDate; day++) {
                const d = new Date(year, month - 1, day);
                const weekNum = getWeekNumber(d);

                if (weekNum !== currentWeekNum) {
                    if (currentWeekNum !== null) {
                        weekInfo.push({
                            weekNum: currentWeekNum,
                            start: weekStart,
                            end: day - 1
                        });
                    }
                    currentWeekNum = weekNum;
                    weekStart = day;
                }
            }
            // Add last week
            if (currentWeekNum !== null) {
                weekInfo.push({
                    weekNum: currentWeekNum,
                    start: weekStart,
                    end: endDate
                });
            }

            // Build table
            let html = `<h2 style="color: #333; margin-bottom: 15px;">${monthNames[month - 1]} ${year}</h2>`;
            html += '<table class="summary-table">';

            // Week header row
            html += '<tr>';
            html += '<th class="member-header"></th>';
            weekInfo.forEach(week => {
                const colSpan = week.end - week.start + 1;
                html += `<th colspan="${colSpan}" class="week-header">W${week.weekNum}</th>`;
            });
            html += '</tr>';

            // Date and day name row
            html += '<tr class="date-number-row">';
            html += '<td class="member-header">Team Member</td>';
            for (let day = 1; day <= endDate; day++) {
                const dayName = getDayName(day).substring(0, 1);
                html += `<td>${day}<br>${dayName}</td>`;
            }
            html += '</tr>';

            // User rows
            selectedUserIds.forEach(userId => {
                const user = allUsers.find(u => u.id === userId);
                const userName = user ? user.username : 'Unknown';
                const userSchedule = teamData[userId] || [];

                html += '<tr>';
                html += `<td class="member-header">${userName}</td>`;

                for (let day = 1; day <= endDate; day++) {
                    const dateStr = `${year}-${String(month).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
                    const dayEntries = userSchedule.filter(e => {
                        // Ensure date match - handle both string and date formats
                        const entryDate = typeof e.date === 'string' ? e.date : new Date(e.date).toISOString().split('T')[0];
                        return entryDate === dateStr;
                    });
                    const activity = dayEntries.length > 0 ? getDominantActivity(dayEntries) : null;
                    const activityClass = getActivityClass(activity || 'Off');
                    const displayText = getActivityDisplay(activity);

                    html += `<td class="activity-cell ${activityClass}">${displayText}</td>`;
                }

                html += '</tr>';
            });

            html += '</table>';

            return html;
        }

        function showError(message) {
            const errorContainer = document.getElementById('errorContainer');
            errorContainer.innerHTML = `<div class="error-message">${message}</div>`;
        }

        function showLoading(show = true) {
            document.getElementById('loadingContainer').style.display = show ? 'block' : 'none';
        }
    </script>
</body>
</html>

