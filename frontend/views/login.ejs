<!DOCTYPE html>
<html>
<head>
    <title>Login - Team Scheduler</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        body {
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            background-color: var(--light-bg);
        }
        .login-card {
            width: 100%;
            max-width: 400px;
        }
        .login-header {
            text-align: center;
            margin-bottom: 30px;
        }
        .login-header h1 {
            margin: 0;
            color: var(--primary-color);
            font-size: 2.5em;
        }
        .login-header p {
            color: #666;
            margin: 10px 0 0 0;
        }
        .help-text {
            text-align: center;
            color: #999;
            font-size: 0.85em;
            margin-top: 25px;
            padding: 15px;
            background-color: #f9f9f9;
            border-radius: 4px;
        }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="login-header">
            <h1>Team Scheduler</h1>
            <p>Welcome back! Please login.</p>
        </div>
        
        <form action="/login" method="POST" class="card">
            <div class="form-group">
                <label for="username">Username</label>
                <input type="text" id="username" name="username" placeholder="Enter your username" required autofocus>
            </div>
            <div class="form-group">
                <label for="password">Password</label>
                <input type="password" id="password" name="password" placeholder="Enter your password" required>
            </div>
            <button type="submit" class="btn btn-primary" style="width: 100%; margin-top: 10px; padding: 12px;">Login</button>
        </form>

        <div class="help-text">
            <strong>Default Credentials</strong><br>
            User: <code>admin</code> / Pass: <code>pass</code>
        </div>
    </div>
</body>
</html>