<div id="editModal" class="modal">
    <div class="modal-content">
        <div class="modal-header">Edit Activity</div>
        <div class="modal-body">
            <div class="form-group">
                 <label><strong>Date:</strong></label>
                 <input type="text" id="modalDate" readonly style="padding: 8px; border: 1px solid #ddd; border-radius: 4px; font-weight: bold; background-color: #f9f9f9;">
             </div>
             <div class="form-group">
                  <label><strong>📅 Basic Activities (24 Hours):</strong></label>
                  <div class="activity-buttons-container" style="grid-template-columns: repeat(4, 1fr);">
                      <button type="button" class="activity-btn d active" onclick="selectShift('D')" title="Development (24h)">D</button>
                      <button type="button" class="activity-btn s" onclick="selectShift('S')" title="Support (24h)">S</button>
                      <button type="button" class="activity-btn oncall" onclick="selectShift('OnCall')" title="OnCall (24h)">OnCall</button>
                      <button type="button" class="activity-btn leave" onclick="selectShift('Leave')" title="Leave (24h)">Leave</button>
                      <button type="button" class="activity-btn v" onclick="selectShift('V')" title="Vacation (24h)">V</button>
                      <button type="button" class="activity-btn h" onclick="selectShift('H')" title="Holiday (24h)">H</button>
                      <button type="button" class="activity-btn off" onclick="selectActivityType('Off')" title="Off (24h)">Off</button>
                  </div>

                  <label style="margin-top: 16px; display:block; font-weight: bold;">📊 Shift Type (9 Hours):</label>
                  <div class="activity-buttons-container" style="grid-template-columns: repeat(5, 1fr); margin-bottom: 4px;">
                      <button type="button" class="activity-btn shifta" onclick="selectShift('ShiftA')" title="Shift A (9h: 5h S, 4h D)">A</button>
                      <button type="button" class="activity-btn shiftb" onclick="selectShift('ShiftB')" title="Shift B (9h: 5h S, 4h D)">B</button>
                      <button type="button" class="activity-btn shiftc" onclick="selectShift('ShiftC')" title="Shift C (9h: 5h S, 4h D)">C</button>
                      <button type="button" class="activity-btn shiftd" onclick="selectShift('ShiftD')" title="Shift D (9h: 5h S, 4h D)">D</button>
                      <button type="button" class="activity-btn shifte" onclick="selectShift('ShiftE')" title="Shift E (9h: 5h S, 4h D)">E</button>
                  </div>
                  <small style="display: block; color: #666; margin-bottom: 12px; font-style: italic;">
                      * Shifts are 9-hour blocks consisting of 5h Support (S) and 4h Development (D).
                  </small>

                  <label style="display:block; margin-bottom: 12px; font-weight: bold;">🔔 Add OnCall (Increases Total Hours):</label>
                  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 0;">
                      <label style="display: flex; align-items: center; gap: 8px; font-weight: normal; cursor: pointer;">
                          <input type="checkbox" id="ocBefore" onchange="updateShiftSelection()" style="width: 18px; height: 18px; cursor: pointer;">
                          <span title="+2 hours at start of day">At Start (+2h)</span>
                      </label>
                      <label style="display: flex; align-items: center; gap: 8px; font-weight: normal; cursor: pointer;">
                          <input type="checkbox" id="ocAfter" onchange="updateShiftSelection()" style="width: 18px; height: 18px; cursor: pointer;">
                          <span title="+5 hours at end of day">At End (+5h)</span>
                      </label>
                  </div>

                  <input type="hidden" id="modalActivity" value="D">
                  <input type="hidden" id="selectedShift" value="">
              </div>
              <div class="form-group">
                  <label><strong>📝 Notes (optional):</strong></label>
                  <textarea id="modalNotes" class="notes-input" rows="2" placeholder="Add any notes about this activity..."></textarea>
              </div>
          </div>
          <div class="modal-buttons">
              <button class="modal-btn modal-fill-btn" onclick="fillNext5Days()" style="font-weight: bold; flex: 1;">⏭️ Apply to Next 5 Days</button>
              <button class="modal-btn modal-save-btn" onclick="saveModalChanges()">Save</button>
              <button class="modal-btn modal-cancel-btn" onclick="closeModal()">Cancel</button>
          </div>
    </div>
</div>
