<!DOCTYPE html>
<html>
<head>
    <title>Manage Roles - Team Scheduler</title>
</head>
<body>
    <%- include('header', { activePage: 'members' }) %>

    <div class="container">
        <header class="page-header">
            <h1>Manage Roles</h1>
            <div class="action-buttons">
                <a href="/roles/add" class="btn btn-secondary">Add New Role</a>
                <a href="/" class="btn btn-primary">Back to Users</a>
            </div>
        </header>

        <div class="card">
            <table>
                <thead>
                    <tr>
                        <th>Role Name</th>
                        <th>Description</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% roles.forEach(role => { %>
                        <tr>
                            <td><strong><%= role.name %></strong></td>
                            <td><%= role.description || 'N/A' %></td>
                            <td>
                                <button class="status-btn <%= role.active ? 'active' : 'inactive' %>" 
                                        onclick="toggleRole('<%= role.id %>')"
                                        title="<%= role.active ? 'Deactivate' : 'Activate' %>">
                                    <%= role.active ? 'Active' : 'Inactive' %>
                                </button>
                            </td>
                            <td>
                                <div class="row-actions">
                                    <a href="/roles/edit/<%= role.id %>" class="btn-icon edit-btn" title="Edit">✏️</a>
                                    <button class="btn-icon delete-btn" onclick="deleteRole('<%= role.id %>')" title="Delete">🗑️</button>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>

    <style>
        .status-btn {
            border: none;
            padding: 4px 12px;
            border-radius: 12px;
            font-size: 0.85em;
            font-weight: bold;
            cursor: pointer;
            transition: all 0.3s;
        }
        .status-btn.active { background-color: #e8f5e9; color: #2e7d32; }
        .status-btn.inactive { background-color: #ffebee; color: #c62828; }
        .status-btn:hover { opacity: 0.8; }
    </style>
</body>
</html>

