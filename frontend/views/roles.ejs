<!DOCTYPE html>
<html>
<head>
    <title>Role Management</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 20px; }
        h1 { color: #333; }
        .action-buttons { margin-bottom: 20px; }
        .action-buttons button { padding: 10px 15px; margin-right: 10px; cursor: pointer; border: none; }
        .add-btn { background-color: #4CAF50; color: white; }
        .add-btn:hover { background-color: #45a049; }
        .back-btn { background-color: #999; color: white; }
        .back-btn:hover { background-color: #888; }
        table { width: 100%; border-collapse: collapse; margin-top: 20px; }
        table, th, td { border: 1px solid #ddd; }
        th { background-color: #2196F3; color: white; text-align: left; padding: 12px; }
        td { padding: 12px; }
        tr:hover { background-color: #f5f5f5; }
        .edit-btn, .delete-btn, .toggle-btn { padding: 5px 10px; cursor: pointer; border: none; margin-right: 5px; }
        .edit-btn { background-color: #2196F3; color: white; }
        .delete-btn { background-color: #f44336; color: white; }
        .toggle-btn { background-color: #FF9800; color: white; }
        .status { padding: 5px 10px; border-radius: 3px; }
        .active { background-color: #4CAF50; color: white; }
        .inactive { background-color: #999; color: white; }
    </style>
</head>
<body>
    <h1>Role Management</h1>

    <div class="action-buttons">
        <button class="add-btn" onclick="location.href='/roles/add'">Add New Role</button>
        <button class="back-btn" onclick="location.href='/'">Back to Users</button>
    </div>

    <table>
        <tr>
            <th>Role Name</th>
            <th>Description</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
        <% roles.forEach(role => { %>
            <tr>
                <td><strong><%= role.name %></strong></td>
                <td><%= role.description || 'N/A' %></td>
                <td>
                    <span class="status <%= role.active ? 'active' : 'inactive' %>">
                        <%= role.active ? 'Active' : 'Inactive' %>
                    </span>
                </td>
                <td>
                    <button class="edit-btn" onclick="location.href='/roles/edit/<%= role.id %>'">Edit</button>
                    <button class="toggle-btn" onclick="toggleRole('<%= role.id %>')"><%= role.active ? 'Deactivate' : 'Activate' %></button>
                    <button class="delete-btn" onclick="deleteRole('<%= role.id %>')">Delete</button>
                </td>
            </tr>
        <% }) %>
    </table>

    <script>
        function deleteRole(id) {
            if(confirm('Are you sure you want to delete this role? This action cannot be undone.')) {
                fetch(`/proxy/roles/delete/${id}`, { method: 'DELETE', credentials: 'include' })
                .then(response => {
                    if (response.ok) {
                        location.reload();
                    } else {
                        alert("Failed to delete role. It may still be in use.");
                    }
                })
                .catch(error => {
                    console.error("Error:", error);
                    alert("Error deleting role");
                });
            }
        }

        function toggleRole(id) {
            fetch(`/proxy/roles/toggle/${id}`, {
                method: 'PUT',
                headers: {
                    'Content-Type': 'application/json'
                },
                credentials: 'include'
            })
            .then(response => {
                if (response.ok) {
                    location.reload();
                } else {
                    alert("Failed to toggle role status.");
                }
            })
            .catch(error => {
                console.error("Error:", error);
                alert("Error toggling role status");
            });
        }
    </script>
</body>
</html>

