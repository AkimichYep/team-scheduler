<!DOCTYPE html>
<html>
<head>
    <title>Add Role - Team Scheduler</title>
</head>
<body>
    <%- include('header', { activePage: 'members' }) %>

    <div class="container">
        <header class="page-header">
            <h1>Add New Role</h1>
            <a href="/roles" class="btn btn-primary">Back to Roles</a>
        </header>

        <form action="/proxy/roles/add" method="POST" class="card">
            <div class="form-group">
                <label for="name">Role Name</label>
                <input type="text" id="name" name="name" placeholder="e.g., L2_SUPPORT" required autofocus>
            </div>
            
            <div class="form-group">
                <label for="description">Description</label>
                <textarea id="description" name="description" placeholder="Brief description of the role responsibilities" rows="4"></textarea>
            </div>

            <div style="margin-top: 25px; display: flex; gap: 10px;">
                <button type="submit" class="btn btn-secondary" style="flex: 2;">Create Role</button>
                <a href="/roles" class="btn btn-danger" style="flex: 1; text-align: center;">Cancel</a>
            </div>
        </form>
    </div>

    <style>
        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
        }
        textarea {
            width: 100%;
            padding: 10px;
            border: 1px solid var(--border-color);
            border-radius: 4px;
            font-family: inherit;
        }
    </style>
</body>
</html>

