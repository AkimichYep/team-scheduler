<!DOCTYPE html>
<html>
<head>
    <title>Edit User</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 0; padding: 0; }
        .form-container { max-width: 500px; margin: 30px auto; padding: 20px; }
        input, select, button, a { padding: 8px; margin: 5px 0; display: block; width: 100%; }
        button { background-color: #4CAF50; color: white; border: none; cursor: pointer; }
        button:hover { background-color: #45a049; }
        a { text-align: center; background-color: #999; color: white; text-decoration: none; }
        a:hover { background-color: #888; }
        label { display: block; margin-top: 10px; }
    </style>
</head>
<body>
    <%- include('header') %>

    <div class="form-container">
        <h2>Edit User</h2>
        <form action="/proxy/edit/<%= user.id %>" method="POST">
            <input type="text" name="username" value="<%= user.username %>" required>

            <label for="role">Role:</label>
            <select name="roleId" id="role" required>
                <% roles.forEach(role => { %>
                    <option value="<%= role.id %>" <%= user.role.id === role.id ? 'selected' : '' %> >
                        <%= role.name %>
                    </option>
                <% }) %>
            </select>

            <input type="text" name="project" value="<%= user.project %>">

            <label>
                <input type="checkbox" name="active" <%= user.active ? 'checked' : '' %>> Active
            </label>

            <button type="submit">Save Changes</button>
            <a href="/">Cancel</a>
        </form>
    </div>
</body>
</html>